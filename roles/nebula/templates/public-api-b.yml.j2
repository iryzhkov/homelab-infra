# Ansible managed, from roles/nebula/templates/public-api-b.yml.j2.
# Do not edit on the host: the next playbook run overwrites it.
#
# The second edge VM, 10.42.0.10, joined 2026-10-02. The same as public-api's
# configuration apart from its own certificate; see public-api.yml.j2 for why
# the relay and punchy blocks are there. The open inbound rule is what lets
# mesh clients reach its dnsmasq and Traefik, as on public-api.

pki:
  ca: /etc/nebula/ca.crt
  cert: /etc/nebula/public-api-b.crt
  key: /etc/nebula/public-api-b.key

static_host_map:
  "10.42.0.1": ["150.230.40.9:4242"]

lighthouse:
  am_lighthouse: false
  interval: 60
  hosts:
    - "10.42.0.1"

relay:
  relays:
    - 10.42.0.1
  am_relay: false
  use_relays: true

punchy:
  punch: true
  respond: true
  delay: 1s

listen:
  host: 0.0.0.0
  port: 4242

tun:
  dev: nebula1
  drop_local_broadcast: false
  drop_multicast: false

firewall:
  outbound:
    - port: any
      proto: any
      host: any

  inbound:
    - port: any
      proto: any
      host: any
