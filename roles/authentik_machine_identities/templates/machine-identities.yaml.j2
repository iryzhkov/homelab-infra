{% set spec = machine_identity_spec %}
# {{ ansible_managed }}
#
# Rendered by roles/authentik_machine_identities and stored in Authentik as the
# blueprint "{{ authentik_machine_identities_blueprint_name }}". The next run puts back
# any change made to these objects in the admin interface.
#
# The line below is this role's ownership record: every object this blueprint
# names. A later run only removes, or keeps managing, objects listed there.
{{ spec.marker }}
version: 1
metadata:
  name: {{ authentik_machine_identities_blueprint_name | to_json }}
  labels:
    blueprints.goauthentik.io/description: Managed by homelab-infra (playbooks/authentik.yml, machine identities)
entries:
{% for service, access in spec.services.items() %}
{% if access.state == 'present' %}
  # Fixed {{ service }} audience and claims from its operator-owned grants.
{% for scope, mapping in access.scope_mappings.items() %}
  - model: authentik_providers_oauth2.scopemapping
    id: {{ service }}-scope{{ '' if loop.first else '-' ~ loop.index }}
    identifiers:
      name: {{ mapping | to_json }}
    attrs:
      scope_name: {{ scope | to_json }}
      description: ""
      expression: {{ access.expression | to_json }}
{% endfor %}
  # Client credentials only, {{ access.token_seconds }}-second tokens signed by an
  # existing keypair. The provider's client secret is never read or delivered:
  # hosts authenticate with their own account's app password.
  - model: authentik_providers_oauth2.oauth2provider
    id: {{ service }}-provider
    identifiers:
      name: {{ access.name | to_json }}
    attrs:
      client_type: confidential
      client_id: {{ access.client_id | to_json }}
      grant_types: [client_credentials]
      redirect_uris: []
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      access_token_validity: seconds={{ access.token_seconds }}
      include_claims_in_id_token: true
      issuer_mode: per_provider
      signing_key: !Find [authentik_crypto.certificatekeypair, [kp_uuid, {{ access.signing_key | to_json }}]]
      property_mappings:
{% for scope in access.scope_mappings %}
        - !KeyOf {{ service }}-scope{{ '' if loop.first else '-' ~ loop.index }}
{% endfor %}
  - model: authentik_core.application
    id: {{ service }}-application
    identifiers:
      slug: {{ access.slug | to_json }}
    attrs:
      name: {{ access.name | to_json }}
      provider: !KeyOf {{ service }}-provider
      policy_engine_mode: any
      # Kept out of every person's application library.
      meta_launch_url: blank://blank
{% endif %}
{% endfor %}
  # --- Service-independent: accounts, app passwords, membership. ---
{% for item in spec.identities if item.state == 'present' %}
  # {{ item.host }} / {{ item.profile }}: an ordinary service account with no
  # roles; its only group is the one bound to the application below.
  - model: authentik_core.user
    id: user-{{ loop.index }}
    identifiers:
      username: {{ item.username | to_json }}
    attrs:
      name: {{ ('Chaldea ' ~ item.host ~ ' ' ~ item.profile) | to_json }}
      type: service_account
      path: homelab-infra/machine-identities
      is_active: true
      roles: []
      attributes: {{ item.attributes | to_json }}
  # App password generation {{ item.generation }}; its key is generated by Authentik
  # and only read back to be written to the host.
  - model: authentik_core.token
    identifiers:
      identifier: {{ item.token | to_json }}
    attrs:
      user: !KeyOf user-{{ loop.index }}
      intent: app_password
      expiring: true
      expires: {{ item.expires | to_json }}
      description: {{ ('Chaldea ' ~ item.host ~ ' ' ~ item.profile ~ ' ' ~ ('Jocasta' if item.service == 'jocasta' else item.service) ~ ' access, generation ' ~ item.generation) | to_json }}
{% endfor %}
{% for service, access in spec.services.items() %}
{% if access.state == 'present' %}
  # Preflight refuses foreign members; set membership to the present identities.
  - model: authentik_core.group
    id: {{ 'identities-group' if service == 'jocasta' else service ~ '-identities-group' }}
    identifiers:
      name: {{ access.group | to_json }}
    attrs:
      is_superuser: false
      parents: []
      roles: []
      users:
{% set members = spec.identities | selectattr('state', 'equalto', 'present') | selectattr('service', 'equalto', service) | list %}
{% if members %}
{% for item in spec.identities if item.state == 'present' %}
{% if item.service == service %}
        - !KeyOf user-{{ loop.index }}
{% endif %}
{% endfor %}
{% else %}
        []
{% endif %}
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf {{ service }}-application
      group: !KeyOf {{ 'identities-group' if service == 'jocasta' else service ~ '-identities-group' }}
    attrs:
      order: 0
      enabled: true
      negate: false
{% endif %}
{% endfor %}
{% for item in spec.identities %}
{% for token in item.old_tokens + ([item.token] if item.state == 'absent' else []) %}
  - model: authentik_core.token
    state: absent
    identifiers:
      identifier: {{ token | to_json }}
{% endfor %}
{% if item.state == 'absent' %}
  - model: authentik_core.user
    state: absent
    identifiers:
      username: {{ item.username | to_json }}
{% endif %}
{% endfor %}
{% for service, access in spec.services.items() %}
{% if access.state == 'absent' %}
  # Deleting the application also deletes its policy bindings.
  - model: authentik_core.application
    state: absent
    identifiers:
      slug: {{ access.slug | to_json }}
  - model: authentik_providers_oauth2.oauth2provider
    state: absent
    identifiers:
      name: {{ access.name | to_json }}
{% for mapping in access.scope_mappings.values() %}
  - model: authentik_providers_oauth2.scopemapping
    state: absent
    identifiers:
      name: {{ mapping | to_json }}
{% endfor %}
  - model: authentik_core.group
    state: absent
    identifiers:
      name: {{ access.group | to_json }}
{% endif %}
{% endfor %}
