# LAN DNS only. No Cloudflare Tunnel or mesh route.
http:
  routers:
    akasha:
      entryPoints: [websecure]
      rule: 'Host(`akasha.ryzhkov.dev`) && ((Method(`GET`) && (Path(`/healthz`) || Path(`/api/entries`) || Path(`/api/v1/events`) || Path(`/api/v1/receipts`) || PathRegexp(`^/api/entries/[0-9]+$`))) || (Method(`POST`) && (Path(`/api/entries`) || Path(`/api/v1/events`))))'
      service: akasha
      middlewares: [akasha-lan, akasha-rate, akasha-size]
{% include 'router-tls.j2' %}
  middlewares:
    akasha-lan:
      ipAllowList:
        # Use the connection peer, never caller-supplied X-Forwarded-For.
        sourceRange:
{% for subnet in akasha_lan_cidrs %}
          - "{{ subnet }}"
{% endfor %}
    akasha-rate:
      rateLimit:
        average: 20
        burst: 100
    akasha-size:
      buffering:
        # Preserve feed's 256 KiB compatibility limit. Akasha independently
        # caps v1 event bodies at 64 KiB.
        maxRequestBodyBytes: 262144
        memRequestBodyBytes: 262144
  services:
    akasha:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['homelab'].ansible_host }}:1936"
