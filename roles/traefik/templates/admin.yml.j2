# Ansible managed, rendered from roles/traefik/templates/admin.yml.j2.
# The Proxmox nodes come from the hypervisors group in the inventory.
#
http:
  routers:
    proxmox-router:
      entryPoints:
        - websecure
      rule: "Host(`proxmox.ryzhkov.dev`)"
      service: proxmox-service
      tls:
        certResolver: "letencrypt"

  services:
   proxmox-service:
      loadBalancer:
        sticky:
          cookie:
            name: proxmox_node
            secure: true
            httpOnly: true
        healthCheck:
          path: /
          interval: 30s
          timeout: 5s
        servers:
{% for node in groups['hypervisors'] | sort %}
          - url: "https://{{ hostvars[node].ansible_host }}:8006"
{% endfor %}
