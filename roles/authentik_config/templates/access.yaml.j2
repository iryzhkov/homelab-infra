# {{ ansible_managed }}
#
# Rendered from playbooks/vars/authentik.yml by roles/authentik_config and
# stored in Authentik as the blueprint "{{ authentik_blueprint_name }}". Do not
# change these objects in the admin interface: the next run puts them back.
version: 1
metadata:
  name: {{ authentik_blueprint_name }}
  labels:
    blueprints.goauthentik.io/description: Managed by homelab-infra (playbooks/authentik.yml)
entries:
{% for group in authentik_groups %}
  - model: authentik_core.group
    identifiers:
      name: {{ group.name }}
    attrs:
      users:
{% for member in group.members %}
        - !Find [authentik_core.user, [username, {{ member }}]]
{% endfor %}
{% endfor %}

{% for slug, access in authentik_app_access.items() %}
{% for group in access.groups | default([]) %}
  - model: authentik_policies.policybinding
    identifiers:
      target: !Find [authentik_core.application, [slug, {{ slug }}]]
      group: !Find [authentik_core.group, [name, {{ group }}]]
    attrs:
      order: {{ loop.index0 }}
{% endfor %}
{% for user in access.users | default([]) %}
  - model: authentik_policies.policybinding
    identifiers:
      target: !Find [authentik_core.application, [slug, {{ slug }}]]
      user: !Find [authentik_core.user, [username, {{ user }}]]
    attrs:
      order: {{ (access.groups | default([]) | length) + loop.index0 }}
{% endfor %}
{% endfor %}

{% for binding in authentik_removed_bindings %}
  - model: authentik_policies.policybinding
    state: absent
    identifiers:
      target: !Find [authentik_core.application, [slug, {{ binding.app }}]]
{% if binding.user is defined %}
      user: !Find [authentik_core.user, [username, {{ binding.user }}]]
{% else %}
      group: !Find [authentik_core.group, [name, {{ binding.group }}]]
{% endif %}
{% endfor %}

{% for app in authentik_removed_apps %}
  - model: authentik_core.application
    state: absent
    identifiers:
      slug: {{ app.slug }}
  - model: {{ app.provider_model }}
    state: absent
    identifiers:
      name: {{ app.provider_name }}
{% endfor %}

  # One proxy provider (forward auth, single application) and one application
  # per route with `sso: forward`, found by external host and slug, so the
  # provider created by hand for ai.ryzhkov.dev on 2026-08-27 was adopted
  # rather than duplicated. The flows and scope mappings are the ones the
  # admin interface preselects for a new proxy provider.
{% for host, slug in authentik_forward_routes.items() | sort %}
  - model: authentik_providers_proxy.proxyprovider
    id: forward-{{ slug }}
    identifiers:
      external_host: https://{{ host }}
    attrs:
      name: {{ authentik_app_access[slug].title | default(slug | capitalize) }}
      mode: forward_single
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      property_mappings:
{% for scope in ['oauth2/scope-openid', 'oauth2/scope-email', 'oauth2/scope-profile', 'oauth2/scope-entitlements', 'proxy/scope-proxy'] %}
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/{{ scope }}]]
{% endfor %}
  - model: authentik_core.application
    identifiers:
      slug: {{ slug }}
    attrs:
      name: {{ authentik_app_access[slug].title | default(slug | capitalize) }}
      provider: !KeyOf forward-{{ slug }}
      meta_launch_url: https://{{ host }}
{% endfor %}

  # The embedded outpost serves exactly the providers above: the list is
  # replaced, not appended to.
  - model: authentik_outposts.outpost
    identifiers:
      managed: goauthentik.io/outposts/embedded
    attrs:
      providers:
{% for host, slug in authentik_forward_routes.items() | sort %}
        - !KeyOf forward-{{ slug }}
{% else %}
        []
{% endfor %}

  # MFA for {{ authentik_mfa_required_group }}. The default MFA stage (order 30)
  # validates a device whenever the user has one, and skips the stage when
  # they have none. This second stage runs only for a member of the group with
  # no device, and makes them enroll one, so the two never prompt twice.
  - model: authentik_policies_expression.expressionpolicy
    id: mfa-policy
    identifiers:
      name: homelab-admin-without-mfa
    attrs:
      expression: |
        from authentik.stages.authenticator import devices_for_user

        user = request.context.get("pending_user")
        if not user or not ak_is_group_member(user, name={{ authentik_mfa_required_group | to_json }}):
            return False
        return not any(devices_for_user(user))
  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    id: mfa-stage
    identifiers:
      name: homelab-admin-mfa-enroll
    attrs:
      device_classes: [static, totp, webauthn]
      not_configured_action: configure
      configuration_stages:
        - !Find [authentik_stages_authenticator_totp.authenticatortotpstage, [name, default-authenticator-totp-setup]]
        - !Find [authentik_stages_authenticator_webauthn.authenticatorwebauthnstage, [name, default-authenticator-webauthn-setup]]
  # Evaluated when the stage is reached, not when the flow is planned: at
  # planning time the user is not identified yet and the policy would always
  # be false.
  - model: authentik_flows.flowstagebinding
    id: mfa-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf mfa-stage
    attrs:
      order: 31
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf mfa-binding
      policy: !KeyOf mfa-policy
    attrs:
      order: 0
