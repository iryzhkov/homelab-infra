[Unit]
Description=Renew the Chaldea public trust bundle
Wants=network-online.target systemd-timesyncd.service
After=network-online.target systemd-timesyncd.service

[Service]
Type=oneshot
User=chaldea-publisher
Group=chaldea-publisher
UMask=0077
Environment=HOME={{ chaldea_publisher_root }}
Environment=TMPDIR={{ chaldea_publisher_root }}/state
ExecStart={{ chaldea_publisher_program }} --config {{ chaldea_publisher_config_root }}/config.json
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ chaldea_publisher_root }}
PrivateDevices=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
