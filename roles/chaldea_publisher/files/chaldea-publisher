#!/usr/bin/python3
"""Serialized, byte-only trust publisher. Repository content is never executed."""
import argparse
import base64
from contextlib import closing
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import shutil
import sqlite3
import subprocess
import sys
import time
import urllib.request

REMOTE = "ssh://git@github.com/iryzhkov/chaldea-trust.git"
FLEET_REMOTE = "ssh://git@github.com/iryzhkov/chaldea-fleet-config.git"
BUNDLE = "bundle.jws"
GRANTS = "access-trust/issuer-grants.json"
MAX_SEQUENCE = 9007199254740991
REMOTE_VERIFY = "import {createPublicKey, verify} from \"node:crypto\";\nlet input=\"\"; for await (const part of process.stdin) input+=part;\nconst {envelope,anchor}=JSON.parse(input);\nconst parts=envelope.trim().split(\".\");\nif(parts.length!==3) process.exit(1);\nconst header=JSON.parse(Buffer.from(parts[0],\"base64url\"));\nif(header.alg!==\"EdDSA\" || header.typ!==\"chaldea-trust+jws\" || header.kid!==anchor.kid) process.exit(1);\nconst raw=Buffer.from(anchor.public_key.x,\"base64url\");\nif(raw.length!==32) process.exit(1);\nconst key=createPublicKey({key:Buffer.concat([Buffer.from(\"302a300506032b6570032100\",\"hex\"),raw]),format:\"der\",type:\"spki\"});\nif(!verify(null,Buffer.from(parts[0]+\".\"+parts[1]),key,Buffer.from(parts[2],\"base64url\"))) process.exit(1);\nprocess.stdout.write(Buffer.from(parts[1],\"base64url\"));\n"


def require(ok, message):
    if not ok:
        raise RuntimeError(message)


def payload(envelope):
    parts = envelope.strip().split(".")
    require(len(parts) == 3, "invalid compact envelope")
    return json.loads(base64.urlsafe_b64decode(parts[1] + "=" * (-len(parts[1]) % 4)))


def sequence(value):
    require(type(value) is int and 0 < value <= MAX_SEQUENCE, "invalid sequence")
    return value


def next_sequence(state_file, remote_sequence, floor=0):
    # Never create or repair state. The runtime owns its schema and all writes.
    with closing(sqlite3.connect(state_file.as_uri() + "?mode=ro", uri=True)) as db:
        require(db.execute("SELECT value FROM access_meta WHERE name='format'").fetchone()
                == ("chaldea-access-state-v1",), "uninitialized publisher state")
        row = db.execute("SELECT value FROM access_meta WHERE name='trust'").fetchone()
    old = sequence(json.loads(row[0])["sequence"]) if row else 0
    require(type(remote_sequence) is int and remote_sequence >= 0, "invalid remote sequence")
    require(type(floor) is int and 0 <= floor < MAX_SEQUENCE, "invalid recovery sequence floor")
    result = max(old, remote_sequence, floor) + 1
    sequence(result)
    return result


def clock_ok(path, now):
    health = json.loads(path.read_text())
    require(health.get("healthy") is True, "unhealthy clock")
    offset, checked = health.get("offsetSeconds"), health.get("checked_at")
    require(type(offset) in (int, float) and math.isfinite(offset) and abs(offset) <= 30
            and type(checked) is int and 0 <= now - checked <= 30, "unhealthy or stale clock")


def private_file(path):
    s = path.lstat()
    require(path.is_file() and not path.is_symlink() and s.st_nlink == 1
            and s.st_uid == os.geteuid() and s.st_mode & 0o777 == 0o600,
            "unsafe bootstrap file: " + path.name)


class NoHeartbeatRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # Never forward the bearer to a redirect target.
        return None


class Publisher:
    def __init__(self, config):
        self.config = config
        self.stage = "bootstrap"
        self.root = Path(config["root"])
        self.state = self.root / "state"
        self.repo = self.root / "trust.git"
        self.grants_repo = self.root / "fleet.git"
        self.env = {
            "PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": str(self.root),
            "TMPDIR": str(self.state), "LC_ALL": "C",
            "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_TERMINAL_PROMPT": "0", "GIT_ATTR_NOSYSTEM": "1",
            "GIT_SSH_COMMAND": "/usr/bin/ssh -F /dev/null -o BatchMode=yes -o IdentitiesOnly=yes "
                "-o IdentityAgent=none -o StrictHostKeyChecking=yes -o GlobalKnownHostsFile=/dev/null "
                "-o UserKnownHostsFile=" + config.get("known_hosts_file", "/etc/chaldea-publisher/known_hosts")
                + " -i " + str(self.root / "keys/trust-deploy-key"),
            "GIT_AUTHOR_NAME": "Chaldea publisher", "GIT_AUTHOR_EMAIL": "noreply@openai.com",
            "GIT_COMMITTER_NAME": "Chaldea publisher", "GIT_COMMITTER_EMAIL": "noreply@openai.com",
        }

    def run(self, args, data=None, env=None):
        return subprocess.run(args, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              check=True, timeout=90, env=env or self.env).stdout

    def git(self, *args, data=None, index=False, grants=False):
        env = dict(self.env)
        repo = self.grants_repo if grants else self.repo
        if grants:
            env["GIT_SSH_COMMAND"] = env["GIT_SSH_COMMAND"].replace(
                "keys/trust-deploy-key", "keys/fleet-read-key")
        if index:
            env["GIT_INDEX_FILE"] = str(self.state / "index")
        return self.run(["/usr/bin/git", "-c", "core.hooksPath=/dev/null",
                         "-c", "protocol.file.allow=never", "--git-dir=" + str(repo),
                         *args], data, env)

    def maintenance(self, command, *args):
        return self.run([self.config["node"], self.config["runtime"], command, *map(str, args)])

    def bootstrap(self):
        # Protect the executable runtime and every ancestor against path substitution.
        for name in ("node", "runtime"):
            path = Path(self.config[name])
            require(path.is_absolute() and path.is_file(), "missing root-owned runtime")
            for entry in (path, *path.parents):
                s = entry.lstat()
                require(not entry.is_symlink() and s.st_uid == 0 and s.st_mode & 0o022 == 0,
                        "unsafe root-owned runtime")
        for directory in (self.root, self.root / "keys", self.state):
            s = directory.lstat()
            require(directory.is_dir() and not directory.is_symlink()
                    and s.st_uid == os.geteuid() and s.st_mode & 0o777 == 0o700,
                    "unsafe publisher directory")
        for name in ("trust-deploy-key", "fleet-read-key", self.config["kid"] + ".pem"):
            private_file(self.root / "keys" / name)
        for name in ("publisher.sqlite", "verify.sqlite"):
            private_file(self.state / name)
        known = Path(self.config["known_hosts_file"])
        require(known.read_text() == self.config["known_hosts"] + "\n"
                and not known.is_symlink() and known.stat().st_uid == 0
                and known.stat().st_mode & 0o022 == 0, "GitHub host key pin mismatch")
        require(self.config["repository"] == REMOTE and self.config["bundle_path"] == BUNDLE,
                "trust transport pin mismatch")
        anchors = self.config["anchors"]
        require(len(anchors) == 1 and anchors[0]["kid"] == self.config["kid"], "invalid anchor")
        key = anchors[0]["public_key"]
        require(key["kty"] == "OKP" and key["crv"] == "Ed25519", "invalid anchor")
        raw = base64.urlsafe_b64decode(key["x"] + "=")
        require(len(raw) == 32 and hashlib.sha256(bytes.fromhex("302a300506032b6570032100") + raw)
                .hexdigest() == self.config["spki_sha256"], "anchor fingerprint mismatch")
        # Config is installed by root; its anchor is independent of fetched main.
        (self.state / "anchors.json").write_text(json.dumps(anchors) + "\n")

    def fetch(self):
        self.stage = "fetch"
        if not self.repo.exists():
            self.run(["/usr/bin/git", "-c", "core.hooksPath=/dev/null", "init", "--bare", str(self.repo)])
        self.git("fetch", "--no-tags", "--depth=1", REMOTE, "+refs/heads/main:refs/publisher/main")
        return self.git("rev-parse", "--verify", "refs/publisher/main^{commit}").decode().strip()

    def fetch_grants(self):
        self.stage = "fetch-grants"
        if not self.grants_repo.exists():
            self.run(["/usr/bin/git", "-c", "core.hooksPath=/dev/null", "init", "--bare", str(self.grants_repo)])
        self.git("fetch", "--no-tags", "--depth=1", FLEET_REMOTE,
                 "+refs/heads/main:refs/publisher/grants", grants=True)
        base = self.git("rev-parse", "--verify", "refs/publisher/grants^{commit}", grants=True).decode().strip()
        return self.read_blob(base, GRANTS, grants=True)

    def read_blob(self, base, path, grants=False):
        entry = self.git("ls-tree", base, "--", path, grants=grants).decode()
        require(entry.startswith("100644 blob ") and entry.rstrip().endswith("\t" + path),
                "missing or nonregular public input")
        require(int(self.git("cat-file", "-s", base + ":" + path, grants=grants)) <= 262144, "public input too large")
        data = self.git("show", base + ":" + path, grants=grants)
        require(len(data) <= 262144, "public input too large")
        return data

    def authenticate_remote(self, envelope):
        data = json.dumps({"envelope": envelope.decode(), "anchor": self.config["anchors"][0]}).encode()
        raw = self.run([self.config["node"], "--input-type=module", "-e", REMOTE_VERIFY], data)
        bundle = json.loads(raw)
        sequence(bundle["sequence"])
        require(type(bundle["published_at"]) is int and type(bundle["expires_at"]) is int
                and bundle["published_at"] > 0
                and bundle["expires_at"] - bundle["published_at"] == 86400
                and bundle["published_at"] <= time.time() + 30, "invalid signed remote publication")
        return bundle

    def remote_bundle(self, base):
        try:
            # Remote data cannot advance high water or suppress age alerts without a signature.
            # Expired but authentic bytes still carry an authoritative sequence.
            return self.authenticate_remote(self.read_blob(base, BUNDLE))
        except (RuntimeError, ValueError, KeyError, TypeError, subprocess.CalledProcessError):
            return None

    def guard_commit(self, base, commit):
        parents = self.git("rev-list", "--parents", "-n", "1", commit).decode().split()
        require(parents == [commit, base], "publisher commit must have exactly the fetched parent")
        changed = self.git("diff-tree", "--no-commit-id", "--name-only", "-r", "-z", base, commit)
        require(changed == BUNDLE.encode() + b"\0", "refusing commit touching another path")
        self.read_blob(commit, BUNDLE)

    def publish(self, base, emergency_empty=False):
        remote = self.remote_bundle(base)
        previous = sequence(remote["sequence"]) if remote else 0
        number = next_sequence(self.state / "publisher.sqlite", previous, self.config.get("sequence_floor", 0))
        require(number > previous, "sequence must increase")
        grants = b"[]\n" if emergency_empty else self.fetch_grants()
        require(isinstance(json.loads(grants), list) and (json.loads(grants) or emergency_empty),
                "empty grants require explicit operator revocation, not automatic renewal")
        (self.state / "grants.json").write_bytes(grants)
        # Force timesyncd. The runtime must not silently fall back to chrony here.
        require(self.run(["/usr/bin/systemctl", "show", "systemd-timesyncd.service",
                          "--property=ActiveState", "--value"]).strip() == b"active",
                "timesyncd is not active")
        self.stage = "clock-health"
        health = self.state / "clock-health.json"
        self.maintenance("clock-health", "--output", health)
        clock_ok(health, int(time.time()))
        candidate = self.state / "candidate.jws"
        common = ["--clock-health-file", health]
        self.stage = "sign-bundle"
        self.maintenance("sign-bundle", "--state-file", self.state / "publisher.sqlite", *common,
                         "--key-file", self.root / "keys" / (self.config["kid"] + ".pem"),
                         "--kid", self.config["kid"], "--grants-file", self.state / "grants.json",
                         "--sequence", number, "--lifetime", "86400", "--output", candidate)
        # A separate durable verifier authenticates the bytes against the root-installed pin.
        verified = self.state / "verified.jws"
        self.stage = "verify-bundle"
        self.maintenance("install-bundle", "--state-file", self.state / "verify.sqlite", *common,
                         "--anchor-file", self.state / "anchors.json",
                         "--bundle-file", candidate, "--output", verified)
        envelope = verified.read_bytes()
        bundle = payload(envelope.decode())
        require(sequence(bundle["sequence"]) == number and number > previous, "sequence must increase")
        now = int(time.time())
        require(bundle["expires_at"] - bundle["published_at"] == 86400
                and 0 <= now - bundle["published_at"] <= 30, "invalid publication lifetime")
        self.stage = "commit"
        self.git("read-tree", base, index=True)
        blob = self.git("hash-object", "-w", "--stdin", data=envelope).decode().strip()
        self.git("update-index", "--add", "--cacheinfo", "100644," + blob + "," + BUNDLE, index=True)
        tree = self.git("write-tree", index=True).decode().strip()
        commit = self.git("commit-tree", tree, "-p", base, data=(
            "Publish trust bundle sequence " + str(number) +
            "\n\nCo-Authored-By: GPT-6.1-Sol <noreply@openai.com>\n").encode()).decode().strip()
        self.guard_commit(base, commit)
        # No force push or retry/rebase. A concurrent main update fails safely.
        self.stage = "push"
        self.git("push", "--porcelain", REMOTE, commit + ":refs/heads/main")
        os.replace(verified, self.state / "published.jws")
        (self.state / "age-alert").unlink(missing_ok=True)

    def age_alert(self, base):
        bundle = self.remote_bundle(base)
        stale = bundle is None or time.time() - bundle["published_at"] > 43200
        marker = self.state / "age-alert"
        if stale and not marker.exists():
            self.notify("Published trust bundle is missing or older than 12 hours", "warn")
            marker.write_text(base + "\n")
        elif not stale:
            marker.unlink(missing_ok=True)

    def heartbeat(self, success):
        # Monitoring is best effort and must never change the publication result.
        try:
            url = self.config.get("heartbeat_url")
            if not url:
                print("chaldea-publisher: heartbeat=disabled", file=sys.stderr, flush=True)
                return
            token_file = Path(self.config.get(
                "heartbeat_token_file", "/etc/chaldea-publisher/heartbeat-token"))
            try:
                token = token_file.read_text().strip()
            except FileNotFoundError:
                print("chaldea-publisher: heartbeat=disabled", file=sys.stderr, flush=True)
                return
            require(len(token) == 64 and all(c in "0123456789abcdef" for c in token),
                    "invalid heartbeat token")
            result = "true" if success else "false"
            request = urllib.request.Request(url + "?success=" + result, data=b"",
                                             headers={"Authorization": "Bearer " + token},
                                             method="POST")
            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoHeartbeatRedirect())
            with opener.open(request, timeout=10) as response:
                require(200 <= response.status < 300, "heartbeat rejected")
            print("chaldea-publisher: heartbeat=sent success=" + result, file=sys.stderr, flush=True)
        except Exception as error:
            # HTTP errors and response bodies can contain credentials. Log only the class.
            print("chaldea-publisher: heartbeat=error cause=" + type(error).__name__,
                  file=sys.stderr, flush=True)

    def notify(self, message, severity="fail"):
        # Journal is always available through the unit. No igor credentials/home are inherited.
        print("chaldea-publisher: " + message, file=sys.stderr, flush=True)
        feed = shutil.which("feed", path=self.env["PATH"])
        if feed:
            try:
                self.run([feed, "post", message, "--severity", severity,
                          "--source", "chaldea-publisher", "--tag", "trust infra"])
                print("chaldea-publisher: alert route=feed", file=sys.stderr)
                return
            except (OSError, subprocess.SubprocessError):
                pass
        print("chaldea-publisher: alert route=journal", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", default="/etc/chaldea-publisher/config.json")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check-age", action="store_true")
    mode.add_argument("--test-alert", action="store_true")
    mode.add_argument("--emergency-empty", action="store_true")
    args = parser.parse_args()
    publisher = Publisher({"root": "/var/lib/chaldea-publisher"})
    try:
        config = json.loads(Path(args.config).read_text())
        publisher = Publisher(config)
        os.umask(0o077)
        with (publisher.state / "publisher.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            publisher.bootstrap()
            if args.test_alert:
                publisher.notify("Trust publisher deployment alert route check", "info")
                return 0
            base = publisher.fetch()
            if args.check_age:
                publisher.age_alert(base)
            else:
                publisher.publish(base, emergency_empty=args.emergency_empty)
                publisher.heartbeat(True)
        return 0
    except Exception as error:
        if not args.check_age and not args.test_alert:
            publisher.heartbeat(False)
        detail = str(error) if isinstance(error, RuntimeError) else type(error).__name__
        if isinstance(error, subprocess.CalledProcessError):
            detail = "command exit " + str(error.returncode)
            detail += ": " + (error.stderr or b"").decode(errors="replace")[:256]
        detail = detail.replace(str(publisher.root), "[publisher]")
        print("chaldea-publisher: phase=" + publisher.stage + " cause=" + detail, file=sys.stderr)
        # Exactly one failure record per invocation; do not leak command output or key paths.
        publisher.notify("Trust publisher failed; inspect the journal and published main")
        return 1


if __name__ == "__main__":
    sys.exit(main())
