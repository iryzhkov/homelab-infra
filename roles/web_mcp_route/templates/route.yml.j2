# Managed by homelab-infra web-mcp {{ web_mcp_edge.service }}
http:
  routers:
    web-mcp-{{ web_mcp_edge.service }}:
      entryPoints: [websecure]
      rule: 'Host(`{{ web_mcp_edge.host }}`) && (Path(`/mcp`) || Path(`/.well-known/oauth-protected-resource/mcp`)) && !HeaderRegexp(`Cf-Ray`, `.*`)'
      service: web-mcp-{{ web_mcp_edge.service }}
{% if web_mcp_edge.service == 'jocasta' %}
      middlewares: [web-mcp-jocasta-host]
{% endif %}
      tls:
        certResolver: "{{ _web_mcp_route_resolver }}"
        domains:
          - main: "{{ web_mcp_edge.host }}"
{% if web_mcp_edge.service == 'jocasta' %}
  middlewares:
    # Jocasta only, as its HTTPS canary qualified: Host becomes the backend
    # authority for the MCP SDK's host protection; Origin is preserved.
    web-mcp-jocasta-host:
      headers:
        customRequestHeaders:
          Host: "{{ web_mcp_edge.host_rewrite }}"
{% endif %}
  services:
    web-mcp-{{ web_mcp_edge.service }}:
      loadBalancer:
        passHostHeader: true
        responseForwarding:
          flushInterval: -1ms
        servers:
          - url: "{{ web_mcp_edge.upstream }}"
