[Unit]
Description=Export the {{ car_tls_domain }} certificate from Traefik's ACME store

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/car-tls-export {{ car_tls_acme_json }} {{ traefik_cert_resolver }} {{ car_tls_domain }} {{ car_tls_export_dir }} {{ ssh_user }}
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ car_tls_export_dir }}
