#!/bin/sh
# Export the car's dedicated certificate from Traefik's ACME store.
#
#   car-tls-export ACME_JSON RESOLVER DOMAIN DEST_DIR OWNER
#
# Runs as root, because Traefik writes acme.json as root with mode 0600. Writes
# fullchain.pem, privkey.pem and bundle.pem (the two concatenated, which is
# what homelab pulls) into DEST_DIR, each owned by OWNER with mode 0600, and
# only when the certificate changed. Every file is written next to its final
# name and renamed into place, so a reader never sees half a file.
#
# Refuses a certificate that names anything but DOMAIN, so the wildcard can
# never leave through this path. Never prints key material.
set -eu

if [ "$#" -ne 5 ]; then
    echo "usage: car-tls-export ACME_JSON RESOLVER DOMAIN DEST_DIR OWNER" >&2
    exit 2
fi
acme=$1
resolver=$2
domain=$3
dest=$4
owner=$5

umask 077
install -d -m 0700 -o "$owner" -g "$owner" "$dest"
work=$(mktemp -d "$dest/.export.XXXXXX")
trap 'rm -rf "$work"' EXIT

# The entry whose main name is DOMAIN and which has no other names.
select='first(.[$r].Certificates[]? | select(.domain.main == $d and ((.domain.sans // []) | length) == 0))'
if ! jq -e --arg r "$resolver" --arg d "$domain" "$select" "$acme" >/dev/null; then
    echo "no certificate for exactly $domain under resolver $resolver in $acme" >&2
    exit 1
fi
jq -er --arg r "$resolver" --arg d "$domain" "$select | .certificate" "$acme" |
    base64 -d >"$work/fullchain.pem"
jq -er --arg r "$resolver" --arg d "$domain" "$select | .key" "$acme" |
    base64 -d >"$work/privkey.pem"

# The leaf must name DOMAIN and nothing else, must not have expired, and must
# belong to the key next to it.
sans=$(openssl x509 -in "$work/fullchain.pem" -noout -ext subjectAltName |
    sed -n 's/^ *//; 2,$p')
if [ "$sans" != "DNS:$domain" ]; then
    echo "refusing: certificate names '$sans', not exactly DNS:$domain" >&2
    exit 1
fi
openssl x509 -in "$work/fullchain.pem" -noout -checkend 0 >/dev/null ||
    { echo "refusing: certificate for $domain has expired" >&2; exit 1; }
cert_pub=$(openssl x509 -in "$work/fullchain.pem" -noout -pubkey |
    openssl pkey -pubin -outform DER | sha256sum)
key_pub=$(openssl pkey -in "$work/privkey.pem" -pubout -outform DER | sha256sum)
if [ "$cert_pub" != "$key_pub" ]; then
    echo "refusing: certificate and key for $domain do not match" >&2
    exit 1
fi

cat "$work/fullchain.pem" "$work/privkey.pem" >"$work/bundle.pem"
if [ -f "$dest/bundle.pem" ] && cmp -s "$work/bundle.pem" "$dest/bundle.pem"; then
    echo "$domain unchanged"
    exit 0
fi

# bundle.pem last: it is what homelab reads, so the other two are already
# current by the time it changes.
for f in fullchain.pem privkey.pem bundle.pem; do
    chown "$owner:$owner" "$work/$f"
    chmod 0600 "$work/$f"
    mv -f "$work/$f" "$dest/$f"
done
echo "$domain exported, $(openssl x509 -in "$dest/fullchain.pem" -noout -enddate)"
