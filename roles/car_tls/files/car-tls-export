#!/bin/sh
# Export the car's dedicated certificate from lego's store.
#
#   car-tls-export CERT KEY DOMAIN DEST_DIR OWNER
#
# CERT is lego's bundle (leaf first, then the issuer) and KEY its private key,
# both root's. Writes fullchain.pem, privkey.pem and bundle.pem (the two
# concatenated, which is what homelab pulls) into DEST_DIR, each owned by
# OWNER with mode 0600, and only when the certificate changed. Every file is
# written next to its final name and renamed into place, so a reader never
# sees half a file.
#
# Refuses a certificate that names anything but DOMAIN, so nothing broader can
# leave through this path. Never prints key material.
set -eu

if [ "$#" -ne 5 ]; then
    echo "usage: car-tls-export CERT KEY DOMAIN DEST_DIR OWNER" >&2
    exit 2
fi
cert=$1
key=$2
domain=$3
dest=$4
owner=$5

umask 077
install -d -m 0700 -o "$owner" -g "$owner" "$dest"
work=$(mktemp -d "$dest/.export.XXXXXX")
trap 'rm -rf "$work"' EXIT

cp "$cert" "$work/fullchain.pem"
cp "$key" "$work/privkey.pem"

# The leaf must name DOMAIN and nothing else, must not have expired, and must
# belong to the key next to it.
sans=$(openssl x509 -in "$work/fullchain.pem" -noout -ext subjectAltName |
    sed -n 's/^ *//; 2,$p')
if [ "$sans" != "DNS:$domain" ]; then
    echo "refusing: certificate names '$sans', not exactly DNS:$domain" >&2
    exit 1
fi
openssl x509 -in "$work/fullchain.pem" -noout -checkend 0 >/dev/null ||
    { echo "refusing: certificate for $domain has expired" >&2; exit 1; }
cert_pub=$(openssl x509 -in "$work/fullchain.pem" -noout -pubkey |
    openssl pkey -pubin -outform DER | sha256sum)
key_pub=$(openssl pkey -in "$work/privkey.pem" -pubout -outform DER | sha256sum)
if [ "$cert_pub" != "$key_pub" ]; then
    echo "refusing: certificate and key for $domain do not match" >&2
    exit 1
fi

cat "$work/fullchain.pem" "$work/privkey.pem" >"$work/bundle.pem"
if [ -f "$dest/bundle.pem" ] && cmp -s "$work/bundle.pem" "$dest/bundle.pem"; then
    echo "$domain unchanged"
    exit 0
fi

# bundle.pem last: it is what homelab reads, so the other two are already
# current by the time it changes.
for f in fullchain.pem privkey.pem bundle.pem; do
    chown "$owner:$owner" "$work/$f"
    chmod 0600 "$work/$f"
    mv -f "$work/$f" "$dest/$f"
done
echo "$domain exported, $(openssl x509 -in "$dest/fullchain.pem" -noout -enddate)"
