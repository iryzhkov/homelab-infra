# {{ ansible_managed }}. No write, exec, archive or export Docker API access.
services:
  proxy:
    image: wollomatic/socket-proxy@sha256:14b0afd0939218e02736794447868b7d5e1d5b231207b727a935845236f08507
    network_mode: none
    user: "{{ observability_proxy_identity.uid }}:{{ observability_docker_socket.stat.gid }}"
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    mem_limit: 64m
    command:
      - -proxysocketendpoint=/socket/proxy.sock
      - -proxysocketendpointfilemode=0660
      - '-allowGET=^(/v[0-9.]+)?/(_ping|version|info|events|networks|networks/[a-zA-Z0-9_.-]+|containers/json|containers/[a-zA-Z0-9_.-]+/(json|logs|stats))$'
      - '-allowHEAD=^(/v[0-9.]+)?/_ping$'
      - -loglevel=WARN
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/observability-docker-proxy:/socket
    logging:
      driver: local
      options: {max-size: "10m", max-file: "2"}
