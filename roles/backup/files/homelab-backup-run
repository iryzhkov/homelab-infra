#!/usr/bin/env bash
# Run one backup tier and put its result offsite.
#
#   homelab-backup-run hourly    the small SQLite databases, and on a Swarm
#                                worker its pinned stacks' snapshots
#   homelab-backup-run daily     InfluxDB
#   homelab-backup-run weekly    remove superseded Backblaze versions
#   homelab-backup-run verify    restore the offsite copies and check them
#
# `rclone sync` rather than `copy` for these directories, so that pruning a
# local snapshot prunes the offsite one too. The twice-weekly jobs use `copy`
# on purpose — nothing there should disappear because it disappeared locally —
# but a rolling window of snapshots is exactly the case where mirroring is what
# you want.
#
# Deliberately NOT --b2-hard-delete since 2026-09-06, when the bucket gained a
# lifecycle rule that removes superseded versions after 30 days. Syncing away
# an expired snapshot now hides it for a month before Backblaze collects it,
# which turns a mistaken prune into something recoverable. The steady-state
# cost of that window is about a gigabyte and a half, or a cent a month.
#
# Quiet on success, except for the verification tier, whose whole purpose is to
# say out loud that the backups still restore. A failure goes to the feed and
# to the phone: a backup that stopped working is worth interrupting someone
# for, and the alternative is finding out during the next audit.

set -uo pipefail

tier="${1:?usage: homelab-backup-run hourly|daily|weekly|verify}"
config_dir="$HOME/.config/homelab-backup"
root="$HOME/app/backups"
remote="b2:igor-offsite-backup/apps/homelab/backups"

# set -a so the values reach the backup scripts this wrapper calls; sourcing
# alone leaves them as shell variables the children never see.
set -a
# shellcheck source=/dev/null
[ -r "$config_dir/env" ] && . "$config_dir/env"
set +a

output=$(mktemp)
trap 'rm -f "$output"' EXIT

case "$tier" in
    hourly)
        # The Compose-era databases, where this host has any
        # (backup_sqlite_sources: homelab only).
        status=0
        subject="sqlite"
        local_dir=""
        remote_dir=""
        if [ -r "$config_dir/sqlite-sources.json" ]; then
            # The log stays the invoking user's; only the databases need root.
            # shellcheck disable=SC2024
            sudo -n "$HOME/.local/bin/homelab-sqlite-backup" \
                --config "$config_dir/sqlite-sources.json" \
                --out "$root/sqlite" >>"$output" 2>&1
            status=$?
            local_dir="$root/sqlite"
            remote_dir="$remote/sqlite"
        fi
        ;;
    daily)
        "$HOME/.local/bin/homelab-influx-backup" "$root/influxdb" 7 >>"$output" 2>&1
        status=$?
        subject="influxdb"
        local_dir="$root/influxdb"
        remote_dir="$remote/influxdb"
        ;;
    verify)
        "$HOME/.local/bin/homelab-restore-verify" >>"$output" 2>&1
        status=$?
        subject="restore verification"
        local_dir=""
        remote_dir=""
        ;;
    weekly)
        # This used to run `rclone cleanup`, standing in for a lifecycle rule
        # the bucket did not have. It has one now, so the job changed from
        # doing the work to checking that the rule still does it: a rule that
        # quietly disappears would take months to notice, and a rule with
        # daysFromUploadingToHiding set would start expiring live backups.
        "$HOME/.local/bin/homelab-b2-guard" >>"$output" 2>&1
        status=$?
        subject="backblaze lifecycle rule"
        local_dir=""
        remote_dir=""
        ;;
    *)
        echo "unknown tier: $tier" >&2
        exit 2
        ;;
esac

if [ "$status" -eq 0 ] && [ -n "$local_dir" ]; then
    rclone sync "$local_dir" "$remote_dir" >>"$output" 2>&1
    status=$?
    [ "$status" -ne 0 ] && echo "rclone sync to $remote_dir failed" >>"$output"
fi

# The stateful Swarm stacks pinned to this worker: their snapshots, the copy
# on the other worker and, from homelab, the offsite copy. Only on a Swarm
# worker (roles/backup, tasks/swarm.yml), after the tier above so a failure
# here never holds up the databases it already covers. Silent, and touches
# nothing, while no stack is listed.
if [ "$tier" = hourly ] && [ -x /usr/local/sbin/homelab-swarm-snapshot ]; then
    # shellcheck disable=SC2024
    if ! sudo -n /usr/local/sbin/homelab-swarm-snapshot >>"$output" 2>&1; then
        if [ "$status" -ne 0 ]; then
            subject="$subject and swarm snapshots"
        else
            subject="swarm snapshots"
        fi
        status=1
    fi
fi

cat "$output"

if [ "$status" -ne 0 ]; then
    feed post "$subject failed on $(hostname -s)" \
        --severity fail --source backup --tag "backup infra" \
        --body-file "$output"
    homelab-notify -t "$subject failed" -p high -i "backup-$tier" - <"$output" || true
elif [ "$tier" = "verify" ]; then
    # The one tier that reports success: a monthly line in the feed saying the
    # offsite copies were fetched and restored is the evidence the backups are
    # working, and silence cannot say that.
    feed post "offsite restore verified on $(hostname -s)" \
        --severity info --source backup --tag "backup infra" \
        --body-file "$output"
fi

exit "$status"
