#!/usr/bin/env bash
# Fetch B2 snapshots and start isolated services against the restored data.
set -euo pipefail
umask 077
max_age_hours="${1:-6}"
remote=b2:igor-offsite-backup/apps/homelab/backups
scratch=$(mktemp -d)
suffix="${scratch##*.}"
vw_container="vw-restore-verify-$suffix"
pg_container="pg-restore-verify-$suffix"
cleanup() {
    docker rm -f "$vw_container" "$pg_container" >/dev/null 2>&1 || true
    rm -rf "$scratch"
}
trap cleanup EXIT
fail() { echo "FAIL $*" >&2; exit 1; }
newest=$(rclone lsf --files-only "$remote/sqlite/vaultwarden" | sort | tail -1)
[ -n "$newest" ] || fail "vaultwarden: no offsite snapshot"
rclone copyto "$remote/sqlite/vaultwarden/$newest" "$scratch/vw.sqlite3.gz"
# Vaultwarden opens db.sqlite3. Any other filename silently tests an empty DB.
gunzip -c "$scratch/vw.sqlite3.gz" >"$scratch/db.sqlite3"
counts=$(sudo -n python3 - "$scratch/db.sqlite3" "$newest" "$max_age_hours" <<'PY'
import datetime, re, sqlite3, sys
path, name, max_age = sys.argv[1:]
match = re.search(r'(\d{4}-\d{2}-\d{2}_\d{4})', name)
if not match:
    raise SystemExit("FAIL vaultwarden: invalid snapshot timestamp")
taken = datetime.datetime.strptime(match[1], "%Y-%m-%d_%H%M")
age = (datetime.datetime.now() - taken).total_seconds() / 3600
if age < -1 or age > float(max_age):
    raise SystemExit(f"FAIL vaultwarden: snapshot age {age:.1f}h")
with sqlite3.connect("file:" + path + "?mode=ro", uri=True) as restored:
    if restored.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
        raise SystemExit("FAIL vaultwarden: integrity check")
    count = restored.execute("select count(*) from ciphers").fetchone()[0]
with sqlite3.connect("file:/home/iryzhkov/app/vaultwarden/data/db.sqlite3?mode=ro", uri=True) as live:
    current = live.execute("select count(*) from ciphers").fetchone()[0]
if count <= 0 or count < current * .9 - 1:
    raise SystemExit("FAIL vaultwarden: restored row count is unexpectedly low")
print(f"{count} restored ciphers; {current} live; age {age:.1f}h")
PY
)
# No external bindings or production volumes. Use the installed image.
docker run -d --name "$vw_container" -p 127.0.0.1::80 \
    -e SIGNUPS_ALLOWED=false -v "$scratch:/data" vaultwarden/server:latest >/dev/null
port=$(docker port "$vw_container" 80/tcp)
ok=no
for _ in $(seq 20); do
    if curl -fsS -m 3 "http://$port/alive" >/dev/null 2>&1; then ok=yes; break; fi
    sleep 1
done
[ "$ok" = yes ] || fail "vaultwarden: restored service did not become healthy"
echo "ok vaultwarden: $counts; restored database served"

dump=$(rclone lsf --files-only --include "authentik_*" "$remote/postgres" | sort | tail -1)
[ -n "$dump" ] || fail "authentik: no offsite dump"
python3 - "$dump" <<'PY'
import datetime, re, sys
match = re.search(r'(\d{4}-\d{2}-\d{2}_\d{4})', sys.argv[1])
if not match:
    raise SystemExit("FAIL authentik: invalid dump timestamp")
age = datetime.datetime.now() - datetime.datetime.strptime(match[1], "%Y-%m-%d_%H%M")
# The Monday/Thursday schedule has a four-day gap.
if age.total_seconds() < -3600 or age.total_seconds() > 5 * 86400:
    raise SystemExit("FAIL authentik: dump is stale")
PY
rclone copyto "$remote/postgres/$dump" "$scratch/authentik.sql.gz"
docker run -d --name "$pg_container" -e POSTGRES_PASSWORD=verify \
    -e POSTGRES_USER=authentik -e POSTGRES_DB=authentik postgres:16-alpine >/dev/null
ready=no
for _ in $(seq 30); do
    if docker exec "$pg_container" pg_isready -U authentik >/dev/null 2>&1; then ready=yes; break; fi
    sleep 1
done
[ "$ready" = yes ] || fail "authentik: scratch Postgres did not become ready"
zcat "$scratch/authentik.sql.gz" | docker exec -i "$pg_container" \
    psql -v ON_ERROR_STOP=1 -q -U authentik -d authentik >/dev/null
users=$(docker exec "$pg_container" psql -tAU authentik -d authentik \
    -c "select count(*) from authentik_core_user" | tr -d ' \r\n')
[[ "$users" =~ ^[0-9]+$ ]] && [ "$users" -gt 0 ] || fail "authentik: restored database has no users"
echo "ok authentik: $users users restored from $dump"
