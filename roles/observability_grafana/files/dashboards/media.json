{
  "uid": "homelab-observe-media",
  "title": "Homelab · Media operations",
  "description": "Ansible-managed read-only media metrics and existing Loki logs. No alerting resources or outbound messages.",
  "tags": [
    "homelab",
    "observability",
    "ansible-managed",
    "media"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "url": "/d/homelab-observe-home",
      "keepTime": true
    },
    {
      "title": "Log explorer",
      "type": "link",
      "url": "/d/homelab-observe-logs",
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 21,
      "title": "Favorite worker last run succeeded",
      "type": "stat",
      "description": "1 means the last worker run succeeded, 0 means it failed. Collection success only means its state was readable. Missing data remains unknown.",
      "gridPos": {
        "x": 0,
        "y": 71,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "media_favorite_last_result_success",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 22,
      "title": "Import queue items with unknown age",
      "type": "stat",
      "description": "These items are excluded from oldest-age estimates. Zero known age is not evidence that all imports are recent.",
      "gridPos": {
        "x": 12,
        "y": 71,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "media_import_queue_age_unknown_items",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 1,
      "type": "text",
      "title": "Media operations · dashboard and logs only",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Read-only API collection each minute through Alloy → VictoriaMetrics. No alerts, contact points, notifications or torrent actions. **Empty metrics mean unknown**, not healthy zero; check collector age and source freshness first. The SeedPool policy is a **20 TiB active-seeding floor and 10-day minimum**, not an automatic retirement deadline. Jellystat sync history is observable; its ActivityMonitor poll heartbeat is not exposed by the supported REST API and remains explicitly unknown."
      }
    },
    {
      "id": 2,
      "title": "Collector age",
      "type": "stat",
      "description": "A stale value means collection stopped even when the last source status remains good.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - media_collector_timestamp_seconds",
          "legendFormat": "{{__name__}} {{service}} {{phase}} {{task}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
