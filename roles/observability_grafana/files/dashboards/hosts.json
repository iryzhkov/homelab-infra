{
  "uid": "homelab-observe-hosts",
  "title": "Homelab · Hosts & Hardware",
  "description": "Managed in Ansible. Host names are inventory identities, independent of IP or Swarm placement. Empty panels mean the exporter has not reported that metric; they do not imply a healthy zero.",
  "tags": [
    "homelab",
    "observability",
    "ansible-managed"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/homelab-observe-overview",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Hosts & hardware",
      "type": "link",
      "url": "/d/homelab-observe-hosts",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Containers",
      "type": "link",
      "url": "/d/homelab-observe-containers",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Log explorer",
      "type": "link",
      "url": "/d/homelab-observe-logs",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Agent hosts",
      "type": "link",
      "url": "/d/homelab-observe-agents",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-metrics"
        },
        "query": {
          "query": "label_values(up, host)",
          "refId": "host"
        },
        "definition": "label_values(up, host)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Host health",
      "gridPos": {
        "x": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Host resources and hardware\nOptional temperature and SMART panels remain empty on hosts without a supported sensor or exporter. Filesystems exclude ephemeral container mounts."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{host}} {{device}} {{mountpoint}} {{sensor}} {{chip}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load per logical CPU",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{host=~\"$host\"} / on(host) group_left count by(host) (node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"})",
          "legendFormat": "{{host}} {{device}} {{mountpoint}} {{sensor}} {{chip}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
