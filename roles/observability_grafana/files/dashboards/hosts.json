{
  "uid": "homelab-observe-hosts",
  "title": "Homelab · Hosts & Hardware",
  "description": "Managed in Ansible. Host names are inventory identities, independent of IP or Swarm placement. Empty panels mean the exporter has not reported that metric; they do not imply a healthy zero.",
  "tags": [
    "homelab",
    "observability",
    "ansible-managed"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/homelab-observe-overview",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Hosts & hardware",
      "type": "link",
      "url": "/d/homelab-observe-hosts",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Containers",
      "type": "link",
      "url": "/d/homelab-observe-containers",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Log explorer",
      "type": "link",
      "url": "/d/homelab-observe-logs",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Agent hosts",
      "type": "link",
      "url": "/d/homelab-observe-agents",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-metrics"
        },
        "query": {
          "query": "label_values(up, host)",
          "refId": "host"
        },
        "definition": "label_values(up, host)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "guest",
        "label": "Guest ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-metrics"
        },
        "query": {
          "query": "label_values(pve_guest_info{job=\"pve\",template=\"0\",id=~\"(qemu|lxc)/.+\"}, id)",
          "refId": "guest"
        },
        "definition": "label_values(pve_guest_info{job=\"pve\",template=\"0\",id=~\"(qemu|lxc)/.+\"}, id)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "(qemu|lxc)/.+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Deployments and notes",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Host health",
      "gridPos": {
        "x": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Hosts, guests and physical hardware\nLocal host metrics appear first; ZFS ARC and SMART follow. Guest panels use the **Guest ID** selector and deduplicate both Proxmox cluster views. Proxmox is authoritative for guest limits. Hypervisor memory includes ZFS ARC; optional sensors remain empty when unreported."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (host) (avg by (host,cpu) (rate(node_cpu_seconds_total{host=~\"$host\",job=\"node\",mode=\"idle\"}[$__rate_interval]))))",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load per logical CPU",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(host) (node_load1{host=~\"$host\",job=\"node\"}) / count by(host) (max by(host,cpu) (node_cpu_seconds_total{host=~\"$host\",job=\"node\",mode=\"idle\"}))",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory used",
      "description": "Kernel memory usage including ZFS ARC. Inspect the separate ARC panel before interpreting high hypervisor memory as pressure.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(host) (node_memory_MemTotal_bytes{host=~\"$host\",job=\"node\"}) - max by(host) (node_memory_MemAvailable_bytes{host=~\"$host\",job=\"node\"})",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
