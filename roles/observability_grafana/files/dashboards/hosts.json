      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(100 * (1 - max by(host,cpu)(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\",host=~\"$host\"}[$__rate_interval]))))",
          "legendFormat": "Logical CPU {{cpu}}",
          "range": false,
