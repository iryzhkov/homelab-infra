{
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (host) (count_over_time({host=~\".+\"}[5m]))",
          "legendFormat": "{{host}}"
        }
      ],
      "title": "Log Volume by Host",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (container_name) (count_over_time({job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\" |~ \"(?i)(^|[^a-zA-Z0-9_])(error|exception|fatal|panic)([^a-zA-Z0-9_]|$)\" [5m]))",
          "legendFormat": "{{container_name}}"
        }
      ],
      "title": "Errors Across All Services",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "minVizHeight": 24
      },
      "targets": [
        {
          "expr": "topk(12, sum by (container_name) (count_over_time({job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\"[1h])))",
          "instant": true,
          "legendFormat": "{{container_name}}",
          "queryType": "instant"
        }
      ],
      "title": "Top 12 containers · log lines in the last hour",
      "type": "bargauge",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.container_name}"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\" |~ \"(?i)(^|[^a-zA-Z0-9_])(error|exception|fatal|panic)([^a-zA-Z0-9_]|$)\""
        }
      ],
      "title": "Recent Errors",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{host=~\".+\"} |~ \"(?i)restarting|restart counter|oom-kill|out of memory|killed process|starting docker|stopping docker\""
        }
      ],
      "title": "Restart / OOM lifecycle messages",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 6,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=~\"journal|systemd-journal\",host=~\"proxmox-a|proxmox-b\"} |~ \"(?i)error|warning|failed|critical\""
        }
      ],
      "title": "PVE Host Journal Warnings",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "tags": [
    "homelab",
    "ansible-managed",
    "private-history"
  ],
