{
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (host) (count_over_time({host=~\".+\"}[5m]))",
          "legendFormat": "{{host}}"
        }
      ],
      "title": "Log Volume by Host",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (container_name) (count_over_time({job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\" |~ \"(?i)error|exception|fatal|panic\" [5m]))",
          "legendFormat": "{{container_name}}"
        }
      ],
      "title": "Errors Across All Services",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "expr": "sum by (container_name) (count_over_time({job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\"[1h]))",
          "instant": true,
          "legendFormat": "{{container_name}}"
        }
      ],
      "title": "Log Volume by Container",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\" |~ \"(?i)error|exception|fatal|panic\""
        }
      ],
      "title": "Recent Errors",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{host=~\".+\"} |~ \"(?i)started|restarting|killed|oom|out of memory\""
        }
      ],
      "title": "Container Restart Events",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 6,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=~\"journal|systemd-journal\",host=~\"proxmox-a|proxmox-b\"} |~ \"(?i)error|warning|failed|critical\""
        }
      ],
      "title": "PVE Host Journal Warnings",
      "type": "logs"
    }
  ],
  "refresh": "30s",
