      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "drive",
        "label": "Physical drive",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-metrics"
        },
        "query": {
          "query": "label_values(smartctl_device{job=\"smartctl\"},device)",
          "refId": "drive"
        },
        "definition": "label_values(smartctl_device{job=\"smartctl\"},device)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Deployments and notes",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Read the drive, not a predicted failure date",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "SMART PASS is the drive's current self-report, not a guarantee. Endurance is a manufacturer estimate, not remaining lifetime. Missing wear/limits/error families mean unsupported, not zero."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "All selected drives · SMART health",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max by(host,device)(smartctl_device_smart_status{job=\"smartctl\",device=~\"$drive\"}) * on(host) group_left() max by(host)(node_monitoring_capability_info{job=\"node\",capability=\"smart\",mode=\"physical\"})) * on(host,device) group_left(model_name,drive_label) (label_replace(max by(host,device,model_name)(smartctl_device{job=\"smartctl\"}),\"drive_label\",\"$1\",\"model_name\",\"(.*)\") unless on(host,model_name) (count by(host,model_name)(max by(host,device,model_name)(smartctl_device{job=\"smartctl\"})) > 1) or label_replace(max by(host,device,model_name)(smartctl_device{job=\"smartctl\"}),\"drive_label\",\"$1\",\"device\",\"(.*)\") and on(host,model_name) (count by(host,model_name)(max by(host,device,model_name)(smartctl_device{job=\"smartctl\"})) > 1))",
          "legendFormat": "{{host}} · {{drive_label}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "PASS",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "displayMode": "gradient",
        "showUnfilled": true,
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {
          "titleSize": 14,
          "valueSize": 52
        }
      },
      "id": 2
    },
