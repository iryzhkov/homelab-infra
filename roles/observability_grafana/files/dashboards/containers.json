{
  "uid": "homelab-observe-containers",
  "title": "Homelab · Containers",
  "description": "Managed in Ansible. Host names are inventory identities, independent of IP or Swarm placement. Empty panels mean the exporter has not reported that metric; they do not imply a healthy zero.",
  "tags": [
    "homelab",
    "observability",
    "ansible-managed"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "url": "/d/homelab-observe-home",
      "keepTime": false,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Overview",
      "type": "link",
