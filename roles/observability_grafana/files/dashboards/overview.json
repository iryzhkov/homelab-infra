{
  "uid": "homelab-observe-overview",
  "title": "Homelab · Overview",
  "description": "Managed in Ansible. Host names are inventory identities, independent of IP or Swarm placement. Empty panels mean the exporter has not reported that metric; they do not imply a healthy zero.",
  "tags": [
    "homelab",
    "observability",
    "ansible-managed"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/homelab-observe-overview",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Hosts & hardware",
      "type": "link",
      "url": "/d/homelab-observe-hosts",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Containers",
      "type": "link",
      "url": "/d/homelab-observe-containers",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Log explorer",
      "type": "link",
      "url": "/d/homelab-observe-logs",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Agent hosts",
      "type": "link",
      "url": "/d/homelab-observe-agents",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-metrics"
        },
        "query": {
          "query": "label_values(up, host)",
          "refId": "host"
        },
        "definition": "label_values(up, host)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Homelab observability",
      "gridPos": {
        "x": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Fleet at a glance\nChoose a host above or follow the links to drill down. Metrics arrive through Alloy; services and collectors can move without changing these dashboards. No alerts or notification settings are managed."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reporting hosts",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (host) (up{host=~\"$host\"}))",
          "legendFormat": "{{host}} {{name}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Healthy scrape targets",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{host=~\"$host\"})",
          "legendFormat": "{{host}} {{name}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unhealthy scrape targets",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{host=~\"$host\"} == bool 0)",
          "legendFormat": "{{host}} {{name}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
