            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent tokens · exporter unavailable",
      "description": "Reserved for a real agent usage exporter. No estimate or synthetic fallback.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_tokens_total{host=~\"$host\"}",
