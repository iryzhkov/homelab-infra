{
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\" | container_name=~\".*authentik.*\" |~ \"(?i)login|auth|password|failed|denied|granted|session\""
        }
      ],
      "title": "Authentik Events",
      "type": "logs",
      "description": "Historical retained events only. Current collection deliberately excludes sensitive authentication/password-manager container logs; an empty recent window is expected."
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\" | container_name=~\".*vaultwarden.*\" |~ \"(?i)login|auth|unlock|2fa|failed|denied|identity\""
        }
      ],
      "title": "Vaultwarden Access",
      "type": "logs",
      "description": "Historical retained events only. Current collection deliberately excludes sensitive authentication/password-manager container logs; an empty recent window is expected."
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 30
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (container_name) (count_over_time({job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\" | container_name=~\".*(traefik|proxy).*\" |~ `(?i)\"(?:DownstreamStatus|OriginStatus)\"[[:space:]]*:[[:space:]]*[45][0-9]{2}|[[:space:]][45][0-9]{2}[[:space:]]` [5m]))",
          "legendFormat": "traefik errors"
        }
      ],
      "title": "Traefik 4xx/5xx Responses",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 4,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=~\"journal|systemd-journal\",host=~\"proxmox-a|proxmox-b\"} |~ \"(?i)sshd.*accepted|sshd.*failed|sshd.*invalid|pam_unix.*session\""
        }
      ],
      "title": "SSH Auth (PVE Hosts)",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 5,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"docker\"} | label_format container_name=\"{{ if .container }}{{ .container }}{{ else }}{{ .container_name }}{{ end }}\" | container_name=~\".*cloudflared.*\" |~ \"(?i)error|warning|reconnect|tunnel\""
        }
      ],
      "title": "Cloudflare Tunnel Events",
      "type": "logs"
    }
  ],
  "refresh": "1m",
