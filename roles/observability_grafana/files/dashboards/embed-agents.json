        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(host) (node_memory_MemAvailable_bytes{job=\"node\",host=~\"agent-.*\"}))",
          "legendFormat": "Memory available",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
