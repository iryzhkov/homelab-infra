{
  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "bfn7e4xhxpce8d"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "Indoor"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Indoor"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "Outdoor"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Outdoor"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "Setpoint"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Setpoint"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "query": "from(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"entity_id\"] == \"thermostat_temperature\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> yield(name: \"indoor\")",
          "refId": "Indoor"
        },
        {
          "query": "from(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"entity_id\"] == \"openweathermap_temperature\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> yield(name: \"outdoor\")",
          "refId": "Outdoor"
        },
        {
          "query": "from(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"entity_id\"] == \"thermostat\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> yield(name: \"setpoint\")",
          "refId": "Setpoint"
        }
      ],
      "title": "Temperature — Indoor / Outdoor / Setpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "bfn7e4xhxpce8d"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent",
          "displayName": "${__field.labels.entity_id}"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "query": "import \"strings\"\n\nfrom(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"entity_id\"] =~ /humidity/)\n  |> filter(fn: (r) => r[\"entity_id\"] !~ /baseline/)\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> filter(fn: (r) => r[\"_value\"] >= 0 and r[\"_value\"] <= 100)\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with entity_id: strings.replaceAll(v: strings.replaceAll(v: strings.replaceAll(v: r.entity_id, t: \"_humidity\", u: \"\"), t: \"_air_sensor\", u: \"\"), t: \"_\", u: \" \")}))",
          "refId": "A"
        }
      ],
      "title": "Humidity",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "bfn7e4xhxpce8d"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "alignValue": "left",
        "mergeValues": true,
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "query": "before = from(bucket: \"homeassistant\")\n  |> range(start: -364d, stop: v.timeRangeStart)\n  |> filter(fn: (r) => r[\"domain\"] == \"person\" or r[\"entity_id\"] == \"occupancy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"state\" or r[\"_field\"] == \"value\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: string(v: r._value)}))\n  |> keep(columns: [\"_time\", \"_value\", \"entity_id\"])\n  |> group(columns: [\"entity_id\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({r with _time: v.timeRangeStart}))\n\nwithin = from(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"domain\"] == \"person\" or r[\"entity_id\"] == \"occupancy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"state\" or r[\"_field\"] == \"value\")\n  |> map(fn: (r) => ({r with _value: string(v: r._value)}))\n  |> keep(columns: [\"_time\", \"_value\", \"entity_id\"])\n\nunion(tables: [before, within])\n  |> group(columns: [\"entity_id\"])\n  |> sort(columns: [\"_time\"])",
          "refId": "A"
        }
      ],
      "title": "Presence — who's home",
      "type": "state-timeline",
      "description": "Retained private event-driven history. Most recent actually observed state before the window is carried to its start, then recorded changes follow; this is observed-state continuity, not proof of current live presence.",
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.entity_id}",
          "noValue": "No observed state",
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Absent",
                  "color": "gray"
                },
                "1": {
                  "text": "Present",
                  "color": "blue"
                },
                "off": {
                  "text": "Off",
                  "color": "gray"
                },
                "on": {
                  "text": "On",
                  "color": "blue"
                },
                "home": {
                  "text": "Home",
                  "color": "blue"
                },
                "not_home": {
                  "text": "Away",
                  "color": "gray"
                },
                "unknown": {
                  "text": "Unknown",
                  "color": "orange"
                },
                "unavailable": {
                  "text": "Unavailable",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "bfn7e4xhxpce8d"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 4,
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "query": "before = from(bucket: \"homeassistant\")\n  |> range(start: -364d, stop: v.timeRangeStart)\n  |> filter(fn: (r) => r[\"entity_id\"] == \"is_sleeping\" or r[\"entity_id\"] == \"master_bedroom_bed_occupied\" or r[\"entity_id\"] == \"bedroom_smart_switch_sensor_area1occupancy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"state\" or r[\"_field\"] == \"value\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: string(v: r._value)}))\n  |> keep(columns: [\"_time\", \"_value\", \"entity_id\"])\n  |> group(columns: [\"entity_id\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({r with _time: v.timeRangeStart}))\n\nwithin = from(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"entity_id\"] == \"is_sleeping\" or r[\"entity_id\"] == \"master_bedroom_bed_occupied\" or r[\"entity_id\"] == \"bedroom_smart_switch_sensor_area1occupancy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"state\" or r[\"_field\"] == \"value\")\n  |> map(fn: (r) => ({r with _value: string(v: r._value)}))\n  |> keep(columns: [\"_time\", \"_value\", \"entity_id\"])\n\nunion(tables: [before, within])\n  |> group(columns: [\"entity_id\"])\n  |> sort(columns: [\"_time\"])",
          "refId": "A"
        }
      ],
      "title": "Sleep + Bed Occupancy",
      "type": "state-timeline",
      "description": "Retained private event-driven history. Most recent actually observed state before the window is carried to its start, then recorded changes follow; this is observed-state continuity, not proof of current live presence.",
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.entity_id}",
          "noValue": "No observed state",
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Off",
                  "color": "gray"
                },
                "1": {
                  "text": "On",
                  "color": "blue"
                },
                "off": {
                  "text": "Off",
                  "color": "gray"
                },
                "on": {
                  "text": "On",
                  "color": "blue"
                },
                "home": {
                  "text": "Home",
                  "color": "blue"
                },
                "not_home": {
                  "text": "Away",
                  "color": "gray"
                },
                "unknown": {
                  "text": "Unknown",
                  "color": "orange"
                },
                "unavailable": {
                  "text": "Unavailable",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
