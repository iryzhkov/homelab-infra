{
  "uid": "homelab-observe-unifi",
  "title": "Homelab · UniFi Network",
  "description": "UniFi network devices, WAN roles, traffic and WiFi radio utilization from the dedicated local read-only account. Physical device series are deduplicated independently of polling-host placement.",
  "tags": [
    "homelab",
    "observability",
    "ansible-managed"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "url": "/d/homelab-observe-home",
      "keepTime": false,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/homelab-observe-overview",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Hosts & hardware",
      "type": "link",
      "url": "/d/homelab-observe-hosts",
      "keepTime": true,
      "includeVars": false,
