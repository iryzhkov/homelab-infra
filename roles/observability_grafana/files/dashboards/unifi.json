      "url": "/d/homelab-observe-homeassistant",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "UniFi device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-metrics"
        },
        "query": {
          "query": "label_values(unifi_device_info{job=\"unifi\"}, name)",
          "refId": "device"
        },
        "definition": "label_values(unifi_device_info{job=\"unifi\"}, name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Network health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### Internet, devices and WiFi\nSelect a UniFi device to focus the resource and traffic panels. Fleet counts cover the whole site. WAN roles show the controller's active / backup assignment; traffic counters and radio utilization report observed activity. Data is read-only and refreshed every minute."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Known devices",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by(id) (unifi_device_info{job=\"unifi\"}))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
