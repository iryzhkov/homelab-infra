  "panels": [
    {
      "id": 1,
      "title": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "# Homelab\n\nFind a host, inspect hardware health, or investigate a service.\n\n[Home Assistant](https://home.ryzhkov.dev) · [Service status](https://uptime.ryzhkov.dev) · [Forgejo](https://git.ryzhkov.dev)"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reporting hosts",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by(host) (up{job=\"node\"} == 1))",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "Unavailable",
          "links": [
            {
              "title": "Open details",
              "url": "/d/homelab-observe-hosts",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
