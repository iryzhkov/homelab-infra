#!/usr/bin/env bash
# Build the recovery bundle and report freshness independently for each target.
set -uo pipefail
config="${HOMELAB_OFFSITE_CONFIG:-$HOME/.config/homelab-offsite/env}"
# shellcheck source=/dev/null
[ -r "$config" ] && . "$config"
: "${OFFSITE_STAGE:?}"
: "${OFFSITE_TARGETS:?}"
: "${OFFSITE_STALE_DAYS:=3}"
: "${OFFSITE_REQUIRED_TARGETS:=oci phone}"
mkdir -p "$HOME/.local/state/homelab-backup"
exec 9>"$HOME/.local/state/homelab-backup/offsite.lock"
flock -n 9 || exit 0
output=$(mktemp)
trap 'rm -f "$output"' EXIT
homelab-offsite-bundle >"$output" 2>&1
status=$?
cat "$output"
if [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then
    feed post "offsite bundle could not be built on $(hostname -s)" \
        --severity fail --source offsite --tag "backup infra" --body-file "$output" || true
    homelab-notify -t "offsite bundle failed" -p high -i offsite-build - <"$output" || true
    exit "$status"
fi
now=$(date +%s)
stale=0
for target in $OFFSITE_TARGETS; do
    name=${target%%:*}
    case " $OFFSITE_REQUIRED_TARGETS " in *" $name "*) ;; *) continue ;; esac
    last=0
    [ ! -r "$OFFSITE_STAGE/.last-delivery-$name" ] || read -r last <"$OFFSITE_STAGE/.last-delivery-$name"
    [[ "$last" =~ ^[0-9]+$ ]] || last=0
    days=$(( (now - last) / 86400 ))
    if [ "$last" -eq 0 ] || [ "$days" -ge "$OFFSITE_STALE_DAYS" ]; then
        stale=1
        if [ "$last" -eq 0 ]; then age="never delivered"; else age="${days}d old"; fi
        echo "$name: $age" >>"$output"
        feed post "offsite $name backup stale ($age)" --severity warn \
            --source offsite --tag "backup infra" --body-file "$output" || true
        homelab-notify -t "offsite $name stale ($age)" -i "offsite-$name" - <"$output" || true
    fi
done
# A service failure is visible even if feed or notification delivery is broken.
[ "$status" -eq 0 ] && [ "$stale" -eq 0 ]
