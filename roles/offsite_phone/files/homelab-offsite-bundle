#!/usr/bin/env bash
# Build the small offsite bundle and put a copy on the phone.
#
# Every other copy of the things that matter most is inside the house: the SOPS
# age key is on the laptop and on omarchy-pc, the rclone credentials that reach
# Backblaze are on this host, and the newest database snapshots are here and in
# a bucket that needs those credentials to open. A fire takes all of it at once.
#
# It goes to every mesh node that can hold it: the OCI VM, which is always
# online and genuinely elsewhere; the phone, which leaves the house daily; and
# the travel router, which is only away when travelling and has 126 MB of flash
# to spare. Different failure modes, so one copy is usually available.
#
# Everything in it is encrypted to a recovery age key whose private half is not
# on the phone and not on any machine here — it belongs in Vaultwarden and on
# paper. A stolen phone therefore yields ciphertext.
#
#   homelab-offsite-bundle [--stage-only]
#
# Exit 0 on success, 1 if the bundle could not be built, 2 if it was built and
# staged but no copy reached the phone.

set -uo pipefail

config="${HOMELAB_OFFSITE_CONFIG:-$HOME/.config/homelab-offsite/env}"
# shellcheck source=/dev/null
[ -r "$config" ] && . "$config"

: "${OFFSITE_STAGE:?OFFSITE_STAGE is not set}"
: "${OFFSITE_RECIPIENT:?OFFSITE_RECIPIENT is not set}"
: "${OFFSITE_TARGETS:?OFFSITE_TARGETS is not set}"
: "${OFFSITE_KEEP:=7}"

stage_only=""
[ "${1:-}" = "--stage-only" ] && stage_only=yes

stamp=$(date +%Y-%m-%d_%H%M)
work=$(mktemp -d)
bundle="$OFFSITE_STAGE/homelab-offsite_$stamp.tar.gz.age"
trap 'rm -rf "$work"' EXIT

collect() {
    # collect <source> <name-in-bundle>; a missing source is a failure, because
    # a bundle that is quietly missing the age key is worse than no bundle.
    local src="$1" name="$2"
    if [ ! -e "$src" ]; then
        echo "missing: $src" >&2
        return 1
    fi
    mkdir -p "$work/$(dirname "$name")"
    cp -a "$src" "$work/$name"
}

fail=0

# Keep the infrastructure description current without moving controller keys.
# OFFSITE_REPO is a dedicated bare mirror, never an interactive checkout.
if [ -n "${OFFSITE_REPO:-}" ]; then
    if ! git -C "$OFFSITE_REPO" fetch --prune origin "+refs/heads/*:refs/heads/*" ||
       ! git -C "$OFFSITE_REPO" bundle create "$work/infra.bundle" --all ||
       ! mv "$work/infra.bundle" "$OFFSITE_STAGE/contributed/homelab-infra.bundle"; then
        echo "could not refresh the infrastructure repository bundle" >&2
        exit 1
    fi
fi

# Items the controller contributes, because this host does not have them and
# should not: the SOPS age key, encrypted to the recovery recipient before it
# ever leaves the laptop, and a git bundle of the infrastructure repository.
# They arrive already encrypted and go into the bundle as they are.
if [ -d "$OFFSITE_STAGE/contributed" ] && [ -n "$(ls -A "$OFFSITE_STAGE/contributed" 2>/dev/null)" ]; then
    cp -a "$OFFSITE_STAGE/contributed/." "$work/" || fail=1
else
    echo "missing: nothing in $OFFSITE_STAGE/contributed" >&2
    fail=1
fi

# The credentials that reach the Backblaze bucket, without which the offsite
# backups are unreadable even though they exist.
collect "$HOME/.config/rclone/rclone.conf" "rclone.conf" || fail=1
# The feed and notify tokens are not worth carrying; these are.
collect "$HOME/.config/homelab-backup/env" "homelab-backup-env" || fail=1

# The newest snapshot of each small database, taken from the local copies
# rather than from Backblaze: this bundle is what you use when Backblaze is
# reachable but its credentials are not, or when nothing here survived.
for db in "$HOME"/app/backups/sqlite/*/; do
    [ -d "$db" ] || continue
    name=$(basename "$db")
    newest=$(ls -1 "$db" 2>/dev/null | sort | tail -1)
    [ -z "$newest" ] || collect "$db$newest" "databases/$newest" || fail=1
done
for prefix in authentik miniflux; do
    newest=$(ls -1 "$HOME"/app/backups/postgres/${prefix}_*.sql.gz 2>/dev/null | sort | tail -1)
    [ -z "$newest" ] || collect "$newest" "databases/$(basename "$newest")" || fail=1
done

cat >"$work/RECOVERY.md" <<'MARKDOWN'
# Homelab recovery payload, @STAMP@

You are holding everything needed to rebuild the homelab from nothing, except
the bulk data. This file is written for whoever — or whatever — is doing the
rebuilding, and assumes nothing survives except this bundle and the recovery
key.

## What this is

An encrypted archive built twice a day on homelab and copied to every mesh node
that can hold it: the OCI VM, the phone, and the travel router. It contains the
keys and the descriptions, not the data. The data is in Backblaze B2, and the
credentials to reach it are in here.

## Opening it

The recovery age key is in Vaultwarden and on paper. It is deliberately on no
machine in the house, so if you are reading this from a running system, you
still need to fetch it from one of those two places.

```
@CONTENTS@
```

Its public half is @RECIPIENT@ — check that first if decryption fails.

## What is inside

```
@CONTENTS@
```

| Item | What it is |
|---|---|
| sops-age-key.txt.age | The SOPS key, encrypted again to the same recovery key. Unlocks every secret in the infrastructure repository. |
| nebula-ca.tar.gz.age | The Nebula certificate authority, current and rotated. Without it no new mesh node can be issued a certificate. |
| homelab-infra.bundle | A git bundle of the infrastructure repository: inventory, roles, playbooks and documentation for the whole estate. |
| rclone.conf | Backblaze credentials. Everything else is in that bucket. |
| homelab-backup-env | The InfluxDB admin token used by the backup jobs. |
| databases/ | The newest snapshot of each small database, and the newest Authentik and Miniflux dumps. |

## Restore order

Do these in order. Each step depends on the one before it.

1. **Open the SOPS key.**
   ```sh
   age -d -i homelab-recovery.key sops-age-key.txt.age > ~/.config/sops/age/keys.txt
   chmod 600 ~/.config/sops/age/keys.txt
   ```

2. **Recover the repository.** It describes every host, stack, route and backup
   job. Read its README first; the docs/ directory explains each subsystem.
   ```sh
   git clone homelab-infra.bundle homelab-infra
   cd homelab-infra && less README.md
   ```

3. **Restore Backblaze access**, which is where everything else lives.
   ```sh
   mkdir -p ~/.config/rclone && cp rclone.conf ~/.config/rclone/
   rclone lsd b2:igor-offsite-backup/apps/homelab
   ```

4. **Rebuild the mesh only if the hosts are being rebuilt too.**
   ```sh
   age -d -i homelab-recovery.key nebula-ca.tar.gz.age | tar -xz
   nebula-cert sign -ca-crt ca.crt -ca-key ca.key -name <host> -ip 10.42.0.N/24
   ```

5. **Bring services back.** The repository's playbooks deploy the stacks; the
   databases in this payload seed the small ones, and the rest come from B2:

   | Service | Where its data is |
   |---|---|
   | Vaultwarden, Actual | databases/ here, at most an hour old; attachments from B2 apps/homelab |
   | Authentik, Miniflux | databases/ here, at most a few days old |
   | Immich | B2 data/immich for the library, apps/normandy/postgres for the database |
   | Everything else | B2 apps/homelab, which mirrors ~/app |

## What is not in here, on purpose

The bulk: photographs, media, container images, the Emby and *arr libraries.
This payload is a few megabytes so that it can live on a phone and a travel
router. Restoring the bulk means Backblaze and a long afternoon, and step 3 is
what makes that possible.

Also absent: SSH host and user keys. Issue new ones; nothing here depends on
the old ones except the authorised_keys entries the repository will rewrite.
MARKDOWN

# The markdown above is written with no shell expansion, so its code fences and
# backslashes survive intact; the handful of real values go in here.
(cd "$work" && find . -type f | sed 's|^\./||' | sort > /tmp/offsite-contents.$$)
sed -i -e "s|@STAMP@|$stamp|g" \
       -e "s|@BUNDLE@|$(basename "$bundle")|g" \
       -e "s|@RECIPIENT@|$OFFSITE_RECIPIENT|g" \
       -e "/@CONTENTS@/r /tmp/offsite-contents.$$" \
       -e "/@CONTENTS@/d" \
       "$work/RECOVERY.md"
rm -f /tmp/offsite-contents.$$

if [ "$fail" -ne 0 ]; then
    echo "bundle not built: something required was missing" >&2
    exit 1
fi

command -v age >/dev/null || { echo "age is not installed on this host" >&2; exit 1; }

mkdir -p "$OFFSITE_STAGE"
if ! tar -czf - -C "$work" . | age -r "$OFFSITE_RECIPIENT" -o "$bundle"; then
    rm -f "$bundle"
    echo "encryption failed" >&2
    exit 1
fi
chmod 600 "$bundle"
size=$(stat -c %s "$bundle" 2>/dev/null || echo 0)
# A bundle this small cannot contain the key, the credentials and a repository.
if [ "$size" -lt 50000 ]; then
    rm -f "$bundle"
    echo "bundle is only $size bytes, refusing to keep it" >&2
    exit 1
fi
echo "staged $(basename "$bundle"), $size bytes"

# Keep the staging directory to the same depth as the phone.
while [ "$(ls -1 "$OFFSITE_STAGE"/homelab-offsite_*.tar.gz.age 2>/dev/null | wc -l)" -gt "$OFFSITE_KEEP" ]; do
    rm -f "$(ls -1 "$OFFSITE_STAGE"/homelab-offsite_*.tar.gz.age | head -1)"
done

[ -n "$stage_only" ] && exit 0

# Every target gets a copy on every run, rather than the first one that
# answers: they fail independently and for different reasons. The phone is
# asleep, the travel router is in a bag, the cloud VM is always there. One
# success is enough for the run to have done its job, and which one succeeded
# is what the staleness check reads later.
#
# Each target is name:host:path:keep.
delivered=0
for target in $OFFSITE_TARGETS; do
    name=${target%%:*}; rest=${target#*:}
    host=${rest%%:*}; rest=${rest#*:}
    path=${rest%%:*}; keep=${rest##*:}

    if ! timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 "$host" \
        "mkdir -p '$path'" >/dev/null 2>&1; then
        echo "$name: not reachable"
        continue
    fi
    if ! timeout 600 scp -q -o BatchMode=yes "$bundle" "$host:$path/" 2>/dev/null; then
        echo "$name: copy failed"
        continue
    fi
    # Prune on the target, oldest first. `head -n -N` keeps the newest N.
    kept=$(timeout 30 ssh -o BatchMode=yes "$host" \
        "cd '$path' && ls -1 homelab-offsite_*.tar.gz.age | sort | head -n -$keep | xargs -r rm -f; ls -1 homelab-offsite_*.tar.gz.age | wc -l" 2>/dev/null | tr -d ' \r')
    echo "$name: copied, ${kept:-?} bundle(s) held"
    date +%s >"$OFFSITE_STAGE/.last-delivery-$name"
    delivered=$((delivered + 1))
done

if [ "$delivered" -eq 0 ]; then
    echo "bundle staged but reached no target" >&2
    exit 2
fi
date +%s >"$OFFSITE_STAGE/.last-delivery"
exit 0
