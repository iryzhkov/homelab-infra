#!/bin/sh
# Isolated UDP1514 restriction. No global firewall policy or other port changes.
set -eu
# Atomic chain refresh; --noflush preserves every unrelated chain/rule.
/usr/sbin/iptables-restore --noflush <<'RULES'
*filter
:OBS-SYSLOG - [0:0]
-F OBS-SYSLOG
-A OBS-SYSLOG -i lo -j ACCEPT
-A OBS-SYSLOG -s {{ observability_syslog_guest.address }}/32 -d {{ ansible_host }}/32 -j ACCEPT
-A OBS-SYSLOG -j DROP
COMMIT
RULES
if ! /usr/sbin/iptables -C INPUT -p udp --dport {{ observability_syslog_port }} -j OBS-SYSLOG 2>/dev/null; then
    /usr/sbin/iptables -I INPUT 1 -p udp --dport {{ observability_syslog_port }} -j OBS-SYSLOG
fi
