#!/usr/bin/env python3
"""Owner-aware native VM backups and isolated restores. No live storage restore."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.parse
import uuid


def command(argv, *, stdin=None, timeout=1800):
    result = subprocess.run(argv, input=stdin, text=True, capture_output=True, timeout=timeout)
    if result.returncode:
        # Docker/wget errors can contain authenticated URLs; never echo output.
        raise RuntimeError(f"{argv[0]} command failed (exit {result.returncode})")
    return result.stdout.strip()


def native_helper(argv):
    name = "observability-native-" + uuid.uuid4().hex[:12]
    try:
        return command(["docker", "run", "--name", name, *argv])
    finally:
        # A timed-out Docker client may leave its helper running. Stop it before
        # releasing snapshot references or deleting any scratch directory.
        subprocess.run(["docker", "rm", "-f", "-v", name], capture_output=True, timeout=60)


def api(container, path, params=None, authenticated=False):
    query = urllib.parse.urlencode(params or {})
    url = "http://127.0.0.1:8428" + path + ("?" + query if query else "")
    if authenticated:
        sep = "&" if query else "?"
        script = "set -eu\nkey=$(cat /run/secrets/vm_snapshot_key)\n"
        script += "wget -q -T 30 -O - " + shlex.quote(url + sep + "authKey=") + '"$key"\n'
        result = command(["docker", "exec", "-i", container, "sh", "-s"], stdin=script, timeout=45)
    else:
        result = command(["docker", "exec", container, "wget", "-q", "-T", "30", "-O", "-", url], timeout=45)
    return json.loads(result)


def vector(payload):
    if payload.get("status") != "success" or payload.get("data", {}).get("resultType") != "vector":
        raise RuntimeError("query did not return a successful vector")
    return sorted([{"metric": row["metric"], "value": row["value"]}
                   for row in payload["data"]["result"]], key=lambda row: json.dumps(row["metric"], sort_keys=True))


def size(path):
    return int(command(["du", "-sb", "--exclude=snapshots", str(path)], timeout=120).split()[0])


def room(path, required, config):
    if required > config["max_backup_bytes"]:
        raise RuntimeError("data exceeds configured backup size ceiling")
    if shutil.disk_usage(path).free < required + config["minimum_free_bytes"]:
        raise RuntimeError("insufficient free space for backup or isolated restore")


def image(config, key):
    ref = config[key]
    if not re.fullmatch(r"[^\s]+@sha256:[a-f0-9]{64}", ref):
        raise RuntimeError("helper image must be pinned by sha256")
    return ref


def peer_copy(config, root):
    with open(config["swarm_sync_config"]) as handle:
        sync = json.load(handle)
    peer = sync["peer"]
    ssh = ["ssh", "-i", sync["key"], "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
           "-o", "ConnectTimeout=15", "-o", "StrictHostKeyChecking=yes",
           "-o", "UserKnownHostsFile=" + sync["known_hosts"]]
    target = f"{peer['user']}@{peer['address']}:observability/snapshots/victoriametrics/"
    # Reserved subtree: never overwrite the ordinary stack snapshots/sync stamp.
    command(["rsync", "-a", "--numeric-ids", "--delete", "--mkpath", "--timeout=180",
             "-e", shlex.join(ssh), str(root) + "/", target], timeout=1800)


def backup(config):
    state = Path(config["state_root"])
    owner_file = state / ".swarm-owner"
    containers = command(["docker", "ps", "-q", "--filter",
                          "label=com.docker.swarm.service.name=observability_victoriametrics"]).split()
    if not owner_file.exists() or owner_file.read_text().strip() != config["host"]:
        if containers:
            raise RuntimeError("running VM has missing or different owner marker")
        print("observability: not owner, skipped")
        return
    if len(containers) != 1:
        replicas = command(["docker", "service", "inspect", "--format",
                            "{{.Spec.Mode.Replicated.Replicas}}", "observability_victoriametrics"])
        if replicas == "0":
            print("observability: deliberately stopped for move, skipped")
            return
        raise RuntimeError("owner must have exactly one running VM task")
    container = containers[0]
    root = Path(config["backup_root"])
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    room(root, size(state / "victoriametrics"), config)
    proof_time = int(time.time()) - 120
    proof = vector(api(container, "/api/v1/query", {"query": config["proof_query"], "time": proof_time}))
    if not proof:
        raise RuntimeError("historical proof query returned no data; backup not accepted")
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + uuid.uuid4().hex[:8]
    partial = root / (stamp + ".partial")
    partial.mkdir(mode=0o700)
    (partial / "data").mkdir(mode=0o700)
    snapshot = None
    try:
        created = api(container, "/snapshot/create", authenticated=True)
        snapshot = created.get("snapshot")
        if created.get("status") != "ok" or not snapshot or not re.fullmatch(r"[a-zA-Z0-9_-]+", snapshot):
            raise RuntimeError("native snapshot creation failed")
        native_helper(["--rm", "--network", "none", "--memory", "256m", "--cpus", "0.5",
                 "--mount", f"type=bind,src={state / 'victoriametrics'},dst=/storage,readonly",
                 "--mount", f"type=bind,src={partial / 'data'},dst=/backup",
                 image(config, "vmbackup_image"), "-storageDataPath=/storage",
                 "-snapshotName=" + snapshot, "-dst=fs:///backup",
                 "-concurrency=2", "-maxBytesPerSecond=10485760"])
        room(root, 0, config)
        metadata = {"created": int(time.time()), "host": config["host"], "query": config["proof_query"],
                    "time": proof_time, "expected": proof,
                    "vm_image": command(["docker", "inspect", "--format", "{{.Config.Image}}", container])}
        (partial / "proof.json").write_text(json.dumps(metadata, sort_keys=True) + "\n")
        partial.rename(root / stamp)
    except BaseException:
        shutil.rmtree(partial, ignore_errors=True)
        raise
    finally:
        if snapshot:
            deleted = api(container, "/snapshot/delete", {"snapshot": snapshot}, authenticated=True)
            if deleted.get("status") != "ok":
                raise RuntimeError("native snapshot cleanup failed")
    complete = sorted(p for p in root.iterdir() if p.is_dir() and (p / "proof.json").exists())
    for stale in complete[:-config["keep"]]:
        shutil.rmtree(stale)
    if config.get("peer_copy", True):
        peer_copy(config, root)
    print(f"observability: native backup {stamp}; historical series={len(proof)}")


def restore_check(config, source=None):
    root = Path(config["backup_root"])
    choices = sorted(p for p in root.iterdir() if p.is_dir() and (p / "proof.json").exists())
    backup_path = Path(source).resolve() if source else (choices[-1] if choices else None)
    if backup_path is None:
        raise RuntimeError("no complete native backup")
    metadata = json.loads((backup_path / "proof.json").read_text())
    if int(time.time()) - metadata["created"] > config["restore_max_age_seconds"]:
        raise RuntimeError("backup too old for acceptance")
    # Restore always targets a fresh temporary directory; no live mounts or ports.
    scratch_root = Path(config["restore_root"])
    scratch_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    room(scratch_root, size(backup_path), config)
    name = "observability-restore-" + uuid.uuid4().hex[:12]
    with tempfile.TemporaryDirectory(prefix="vm-", dir=scratch_root) as scratch:
        native_helper(["--rm", "--network", "none", "--memory", "256m", "--cpus", "0.5",
                 "--mount", f"type=bind,src={backup_path / 'data'},dst=/backup,readonly",
                 "--mount", f"type=bind,src={scratch},dst=/storage", image(config, "vmrestore_image"),
                 "-src=fs:///backup", "-storageDataPath=/storage", "-concurrency=2",
                 "-maxBytesPerSecond=10485760"])
        vm_image = metadata["vm_image"]
        if not re.fullmatch(r"[^\s]+@sha256:[a-f0-9]{64}", vm_image):
            raise RuntimeError("backed-up VM image was not immutable")
        try:
            command(["docker", "run", "-d", "--name", name, "--network", "none",
                     "--memory", "512m", "--cpus", "0.5", "--log-driver", "local",
                     "--mount", f"type=bind,src={scratch},dst=/storage", vm_image,
                     "-storageDataPath=/storage", "-retentionPeriod=400d",
                     "-memory.allowedBytes=128MiB", "-storage.minFreeDiskSpaceBytes=100MB"])
            restored = None
            for _ in range(30):
                try:
                    restored = vector(api(name, "/api/v1/query", {"query": metadata["query"], "time": metadata["time"]}))
                    if restored:
                        break
                except (RuntimeError, ValueError):
                    pass
                time.sleep(1)
            if not restored or restored != metadata["expected"]:
                raise RuntimeError("restored historical series differ from saved proof")
            print(f"observability: isolated restore passed; historical series={len(restored)}")
        finally:
            command(["docker", "rm", "-f", "-v", name], timeout=60)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=["backup", "restore-check"])
    parser.add_argument("--config", default="/etc/observability-backup/config.json")
    parser.add_argument("--source", help="explicit local or peer native backup directory for restore-check")
    args = parser.parse_args()
    with open(args.config) as handle:
        config = json.load(handle)
    if config["keep"] < 1:
        raise RuntimeError("keep must be positive")
    # Both operations serialize; retention cannot prune an in-progress restore.
    with open(config["lock_file"], "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if args.operation == "backup":
            backup(config)
        else:
            restore_check(config, args.source)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        # Only controlled exception descriptions are safe to print.
        print("observability backup/restore failed: " +
              (str(exc) if isinstance(exc, RuntimeError) else type(exc).__name__), file=sys.stderr)
        sys.exit(1)
