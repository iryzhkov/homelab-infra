#!/usr/bin/env python3
"""Akasha local readiness and one rolling SQLite snapshot. Never log records."""
import argparse
import json
import os
from pathlib import Path
import shutil
import sqlite3
import sys
import time
import urllib.request

GIB = 1024 ** 3
DB_LIMIT = 4 * GIB
WAL_LIMIT = 64 * 1024 ** 2
STATE_LIMIT = 10 * GIB


def sizes(root):
    # Private service-owned tree; never follow symlinks into another store.
    return sum(p.stat().st_size for p in root.rglob("*")
               if p.is_file() and not p.is_symlink())


def check_storage(root):
    db = root / "events.db"
    wal = root / "events.db-wal"
    if not db.is_file() or db.is_symlink():
        raise RuntimeError("database absent or unsafe")
    if db.stat().st_size > DB_LIMIT:
        raise RuntimeError("main database exceeds 4 GiB")
    if wal.exists() and wal.stat().st_size > WAL_LIMIT:
        raise RuntimeError("WAL exceeds 64 MiB")
    if sizes(root) > STATE_LIMIT:
        raise RuntimeError("state exceeds 10 GiB")
    if shutil.disk_usage(root).free < 128 * 1024 ** 2:
        raise RuntimeError("disk reserve exhausted")
    return db


def snapshot(root):
    db = check_storage(root)
    directory = root / "backup"
    destination = directory / "events.db"
    staging = directory / "events.db.partial"
    directory.mkdir(mode=0o700, exist_ok=True)
    # The old off-host packaged generation is the fallback while this local
    # generation is replaced. Retaining two 4 GiB snapshots exceeds budget.
    reclaim = sum(p.stat().st_size for p in (destination, staging) if p.exists())
    if shutil.disk_usage(root).free + reclaim < DB_LIMIT + 128 * 1024 ** 2:
        raise RuntimeError("insufficient snapshot reserve")
    if sizes(root) - reclaim + DB_LIMIT > STATE_LIMIT:
        raise RuntimeError("insufficient state budget for snapshot")
    for path in (destination, staging):
        path.unlink(missing_ok=True)
    deadline = time.monotonic() + 300

    def progress(status, remaining, total):
        if total * page_size > DB_LIMIT or time.monotonic() > deadline:
            raise RuntimeError("snapshot size or time bound exceeded")

    try:
        with sqlite3.connect(db.as_uri() + "?mode=ro", uri=True, timeout=5) as source:
            page_size = source.execute("PRAGMA page_size").fetchone()[0]
            with sqlite3.connect(staging, timeout=5) as target:
                target.execute("PRAGMA journal_mode=OFF")
                target.execute("PRAGMA max_page_count=%d" % (DB_LIMIT // page_size))
                source.backup(target, pages=256, progress=progress, sleep=0.1)
                if target.execute("PRAGMA quick_check").fetchall() != [("ok",)]:
                    raise RuntimeError("snapshot integrity check failed")
        os.chmod(staging, 0o600)
        with staging.open("rb") as handle:
            os.fsync(handle.fileno())
        os.replace(staging, destination)
        fd = os.open(directory, os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        staging.unlink(missing_ok=True)


def health(root, url):
    check_storage(root)
    snapshot_file = root / "backup/events.db"
    if not snapshot_file.is_file() or time.time() - snapshot_file.stat().st_mtime > 24 * 3600:
        raise RuntimeError("consistent snapshot absent or older than proposed 24h RPO")
    # Local listener only; no bearer and no proxy environment.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(url, timeout=5) as response:
        if response.status != 200 or json.loads(response.read(4097)) != {"ok": True}:
            raise RuntimeError("health endpoint not ready")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["health", "backup"])
    parser.add_argument("--root", type=Path, default=Path("/var/lib/akasha"))
    parser.add_argument("--url", default="http://127.0.0.1:1935/healthz")
    args = parser.parse_args()
    os.umask(0o077)
    try:
        snapshot(args.root.resolve()) if args.action == "backup" else health(args.root.resolve(), args.url)
    except (OSError, RuntimeError, sqlite3.Error, ValueError):
        # No database contents, URLs, request data or credential paths in logs.
        print("akasha " + args.action + ": FAILED; inspect readiness/capacity/backup status", file=sys.stderr)
        return 1
    print("akasha " + args.action + ": ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
