[Unit]
Description=Consistent bounded Akasha SQLite snapshot
After=akasha.service
ConditionPathExists=/var/lib/akasha/events.db

[Service]
Type=oneshot
User=akasha
Group=akasha
UMask=0077
Environment=TMPDIR=/var/lib/akasha/tmp
ExecStart=/usr/local/libexec/akasha-maintenance backup
ExecStopPost=-/usr/local/libexec/akasha-heartbeat --url http://{{ ansible_host }}:3002/api/v1/endpoints/chaldea_akasha-backup/external --token-file /etc/akasha/heartbeat-backup
TimeoutStopSec=10s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/akasha
PrivateTmp=true
TimeoutStartSec=6min
Nice=10
IOSchedulingClass=idle
