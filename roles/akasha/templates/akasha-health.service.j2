[Unit]
Description=Check Akasha readiness, disk bounds and snapshot age
After=akasha.service

[Service]
Type=oneshot
User=akasha
Group=akasha
UMask=0077
Environment=TMPDIR=/var/lib/akasha/tmp
ExecStart=/usr/local/libexec/akasha-maintenance health
ExecStopPost=-/usr/local/libexec/akasha-heartbeat --url http://{{ ansible_host }}:3002/api/v1/endpoints/chaldea_akasha-health/external --token-file /etc/akasha/heartbeat-health
TimeoutStopSec=10s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=15
