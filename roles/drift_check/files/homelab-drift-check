#!/usr/bin/env python3
"""Report where this host no longer matches what was deployed to it.

Reads the manifest that Ansible wrote at deploy time and checks the host
against it: Compose files unchanged, env files present with the expected
variables, mounted configuration files present, and every project running.

The manifest carries checksums and variable names, never values, because this
host holds no age key and cannot decrypt anything. That bounds what can be
checked here: a Compose file edited in place is caught, a secret changed on the
host is not.

It also compares the manifest against what the repository last deployed, not
against the repository as it is now. A change committed but never applied is
the laptop's job to catch, with `ansible-playbook playbooks/site.yml --check`.

Where playbooks/authentik.yml has left its own manifest (homelab), Authentik
is checked too, through its API with a read-only token: the access blueprint
unchanged, every managed application bound and every managed group made up
as the repository declared, and no application the repository does not
manage.

Exit status: 0 clean, 1 drift found, 2 the check itself could not run.
"""

import datetime
import hashlib
import json
import os
import subprocess
import shutil
import sys
import urllib.error
import urllib.parse
import urllib.request

MANIFEST = os.path.expanduser("~/.local/share/homelab-infra/drift-manifest.json")
AUTHENTIK_MANIFEST = os.path.expanduser("~/.local/share/homelab-infra/authentik-manifest.json")
AUTHENTIK_TOKEN = os.path.expanduser("~/.config/homelab-infra/authentik-token")


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def compose_projects():
    """Names of the Compose projects docker currently reports as running."""
    out = subprocess.run(
        ["docker", "compose", "ls", "--format", "json"],
        capture_output=True, text=True, check=True,
    ).stdout
    return {p["Name"]: p.get("Status", "") for p in json.loads(out)}


def env_keys(path):
    keys = []
    with open(path) as handle:
        for line in handle:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                keys.append(line.split("=", 1)[0])
    return sorted(keys)


def check_stack(stack, running):
    """Yield one string per way this stack differs from the manifest."""
    directory = stack["dir"]
    compose = os.path.join(directory, "docker-compose.yml")

    if not os.path.isdir(directory):
        yield f"{stack['name']}: directory {directory} is gone"
        return

    if not os.path.isfile(compose):
        yield f"{stack['name']}: {compose} is missing"
    elif sha256(compose) != stack["compose_sha256"]:
        yield f"{stack['name']}: docker-compose.yml edited on the host"

    if stack["env_file"]:
        env_path = os.path.join(directory, stack["env_file"])
        if not os.path.isfile(env_path):
            yield f"{stack['name']}: {stack['env_file']} is missing"
        else:
            mode = oct(os.stat(env_path).st_mode & 0o777)
            if mode != "0o600":
                yield f"{stack['name']}: {stack['env_file']} is mode {mode}, expected 0o600"
            found = env_keys(env_path)
            # Compared as sets: the order a variable sits in an env file means
            # nothing, and Jinja's sort filter is case-insensitive while
            # Python's is not, so the two lists disagree on DB_DATA_LOCATION
            # against DB_DATABASE_NAME while describing the same file.
            if set(found) != set(stack["env_keys"]):
                missing = sorted(set(stack["env_keys"]) - set(found))
                extra = sorted(set(found) - set(stack["env_keys"]))
                detail = ", ".join(
                    part for part in (
                        f"missing {missing}" if missing else "",
                        f"unexpected {extra}" if extra else "",
                    ) if part
                )
                yield f"{stack['name']}: {stack['env_file']} variables differ ({detail})"

            duplicates = sorted({k for k in found if found.count(k) > 1})
            if duplicates:
                yield f"{stack['name']}: {stack['env_file']} defines {duplicates} more than once"

    for config in stack["config_files"]:
        if not os.path.isfile(os.path.join(directory, config)):
            yield f"{stack['name']}: mounted config {config} is missing"

    if stack["name"] not in running:
        yield f"{stack['name']}: project is not running"
    elif "running" not in running[stack["name"]]:
        yield f"{stack['name']}: project status is '{running[stack['name']]}'"


def upkeeper_findings():
    """Normandy's optional integration marker selects the fleet controller only."""
    marker = os.path.expanduser("~/.config/homelab-infra/upkeeper-drift")
    if not os.path.isfile(marker):
        return [], False
    command = shutil.which("upkeeper")
    if command is None:
        return ["UpKeeper: command unavailable"], True
    try:
        result = subprocess.run(
            [command, "pull", "--all", "--skip-unreachable", "--dry-run", "--json"],
            capture_output=True, text=True, timeout=900, check=False,
        )
        report = json.loads(result.stdout)
        if not isinstance(report.get("hosts"), list):
            raise ValueError("missing host results")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return ["UpKeeper: drift observation failed or returned invalid output"], True
    findings = []
    broken = result.returncode not in (0, 10)
    for host in report["hosts"]:
        if host.get("skipped_unreachable") or host.get("self_managed"):
            continue
        if not host.get("reachable"):
            findings.append(f"UpKeeper {host['host']}: observation failed")
            broken = True
            continue
        entries = list(host.get("components", []))
        if host.get("legacy_updater"):
            entries.append(dict(host["legacy_updater"], name="legacy-updater"))
        for entry in entries:
            if entry.get("state") not in ("converged", "skipped"):
                findings.append(
                    f"UpKeeper {host['host']}/{entry['name']}: {entry.get('state', 'unknown')}"
                )
        if host.get("result") not in ("converged", "updated", "ahead"):
            findings.append(f"UpKeeper {host['host']}: {host.get('result', 'unknown')}")
    if broken and not findings:
        findings.append("UpKeeper: drift observation failed")
    return findings, broken


def authentik_api(url, token):
    """A GET against Authentik's API, returning the decoded JSON."""
    def get(path):
        request = urllib.request.Request(url + path, headers={"Authorization": "Bearer " + token})
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    return get


def authentik_findings(manifest=None, get=None):
    """Where Authentik no longer matches what playbooks/authentik.yml applied.

    The tests pass manifest and get; the timer passes neither, and a host with
    no Authentik manifest has nothing to check.
    """
    if manifest is None:
        if not os.path.isfile(AUTHENTIK_MANIFEST):
            return [], False
        try:
            with open(AUTHENTIK_MANIFEST) as handle:
                manifest = json.load(handle)
            with open(AUTHENTIK_TOKEN) as handle:
                get = authentik_api(manifest["url"], handle.read().strip())
        except (OSError, ValueError, KeyError) as error:
            return [f"Authentik: cannot read the manifest or token ({error})"], True

    findings = []
    try:
        stored = get("/managed/blueprints/?name=" + urllib.parse.quote(manifest["blueprint"]))["results"]
        if not stored:
            findings.append(f"Authentik: blueprint '{manifest['blueprint']}' is gone")
        else:
            content = stored[0].get("content", "")
            if hashlib.sha256(content.encode()).hexdigest() != manifest["blueprint_sha256"]:
                findings.append(f"Authentik: blueprint '{manifest['blueprint']}' changed outside the repository")
            if stored[0].get("status") != "successful":
                findings.append(f"Authentik: blueprint '{manifest['blueprint']}' is {stored[0].get('status')}")

        # The declared configuration, not evaluated access: check_access only
        # honours for_user for a superuser and otherwise silently answers for
        # the caller (authentik/core/api/applications.py, 2025.8.6). With the
        # policy engine mode "any" and only group and user bindings, who may
        # open an application follows from its bindings and the groups'
        # members, which a read-only account can read.
        for slug, expected in sorted(manifest["apps"].items()):
            try:
                app = get(f"/core/applications/{slug}/")
            except urllib.error.HTTPError as error:
                if error.code != 404:
                    raise
                findings.append(f"Authentik {slug}: application is gone")
                continue
            if app.get("policy_engine_mode") != "any":
                findings.append(f"Authentik {slug}: policy engine mode is {app.get('policy_engine_mode')}, "
                                "the repository expects any")
            found = set()
            for binding in get(f"/policies/bindings/?target={app['pk']}&page_size=500")["results"]:
                if binding.get("group_obj"):
                    key = f"group {binding['group_obj']['name']}"
                elif binding.get("user_obj"):
                    key = f"user {binding['user_obj']['username']}"
                else:
                    key = f"policy {(binding.get('policy_obj') or {}).get('name')}"
                if not binding.get("enabled", True) or binding.get("negate"):
                    state = "negated" if binding.get("negate") else "disabled"
                    findings.append(f"Authentik {slug}: binding to {key} is {state}")
                    continue
                found.add(key)
            want = {f"group {g}" for g in expected["groups"]} | {f"user {u}" for u in expected["users"]}
            for key in sorted(found - want):
                findings.append(f"Authentik {slug}: bound to {key} outside the repository")
            for key in sorted(want - found):
                findings.append(f"Authentik {slug}: binding to {key} is missing")

        for name, members in sorted(manifest["groups"].items()):
            found = get(f"/core/groups/?name={urllib.parse.quote(name)}&include_users=true")["results"]
            if not found:
                findings.append(f"Authentik group {name}: is gone")
                continue
            actual = {u["username"] for u in found[0].get("users_obj") or []}
            for user in sorted(actual - set(members)):
                findings.append(f"Authentik group {name}: {user} added outside the repository")
            for user in sorted(set(members) - actual):
                findings.append(f"Authentik group {name}: {user} removed outside the repository")

        # A read-only account cannot list applications (the full list is for
        # superusers), but it can list providers, and every application here
        # has one: the OAuth2 list includes the proxy providers.
        assigned = set()
        for kind in ("oauth2", "saml", "ldap"):
            for provider in get(f"/providers/{kind}/?page_size=500")["results"]:
                if provider.get("assigned_application_slug"):
                    assigned.add(provider["assigned_application_slug"])
        for slug in sorted(assigned - set(manifest["apps"])):
            findings.append(f"Authentik {slug}: application not managed by the repository")
    except (OSError, ValueError, KeyError) as error:
        return findings + [f"Authentik: drift observation failed ({error})"], True
    return findings, False


def main():
    try:
        with open(MANIFEST) as handle:
            manifest = json.load(handle)
    except OSError as error:
        print(f"cannot read the manifest: {error}", file=sys.stderr)
        return 2

    try:
        running = compose_projects()
    except (subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"cannot ask docker what is running: {error}", file=sys.stderr)
        return 2

    deployed = datetime.datetime.fromtimestamp(
        os.path.getmtime(MANIFEST)
    ).strftime("%Y-%m-%d %H:%M")

    findings, upkeeper_broken = upkeeper_findings()
    authentik, authentik_broken = authentik_findings()
    findings.extend(authentik)
    for stack in manifest["stacks"]:
        findings.extend(check_stack(stack, running))

    # Projects running here that the manifest does not describe. Not drift in
    # the strict sense, but it is how an unmanaged stack appears.
    unmanaged = sorted(set(running) - {s["name"] for s in manifest["stacks"]})
    for name in unmanaged:
        findings.append(f"{name}: running but not deployed from the repository")

    stacks = len(manifest["stacks"])
    if not findings:
        print(f"{stacks} stacks match what was deployed on {deployed}")
        return 0

    print(f"{len(findings)} finding(s) across {stacks} stacks, "
          f"deployed {deployed}:")
    for finding in findings:
        print(f"  - {finding}")
    return 2 if upkeeper_broken or authentik_broken else 1


if __name__ == "__main__":
    sys.exit(main())
