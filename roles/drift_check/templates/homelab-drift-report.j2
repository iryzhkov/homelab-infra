#!/usr/bin/env bash
# Run the drift check and put the result where it will be seen.
#
# Quiet when the host matches what was deployed: a daily "nothing changed" entry
# would train the reader to skip the feed. Drift is posted as a warning, and a
# check that could not run at all is posted as a failure, because silence from
# a broken checker looks exactly like silence from a clean host.

set -uo pipefail

output=$(mktemp)
trap 'rm -f "$output"' EXIT

homelab-drift-check >"$output" 2>&1
status=$?

{% if drift_check_peers | default([]) %}
# Hosts that cannot reach the feed themselves are checked from here over SSH.
# public-api sits on the Public API VLAN, which is not permitted to reach the
# feed on homelab, and opening that path so the edge proxy could write into a
# LAN service would be a worse trade than pulling the answer from here.
# The key is the drift-check entry in fleet_ssh_keys, which each peer pins to
# running its checker, so the command named here is only for the reader.
for peer in {{ drift_check_peers | join(' ') }}; do
    peer_output=$(ssh -o BatchMode=yes -o ConnectTimeout=10 \
        -o IdentitiesOnly=yes -i ~/.ssh/id_ed25519_drift "$peer" \
        '.local/bin/homelab-drift-check' 2>&1)
    peer_status=$?
    printf '\n%s:\n%s\n' "$peer" "$peer_output" >>"$output"
    if [ "$peer_status" -ne 0 ] && [ "$status" -eq 0 ]; then
        status=$peer_status
    fi
done
{% endif %}

case "$status" in
    0)
        cat "$output"
        ;;
    1)
        cat "$output"
        feed post "configuration drift on {{ drift_check_scope }}" \
            --severity warn --source drift-check --tag "drift infra" \
            --body-file "$output"
        homelab-notify -t "drift on {{ drift_check_scope }}" -i drift-check - <"$output" || true
        ;;
    *)
        cat "$output" >&2
        feed post "drift check could not run on {{ drift_check_scope }}" \
            --severity fail --source drift-check --tag "drift infra" \
            --body-file "$output"
        homelab-notify -t "drift check broken" -p high -i drift-check - <"$output" || true
        ;;
esac

exit "$status"
