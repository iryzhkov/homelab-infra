[Unit]
Description=Detect stale Jocasta NAS recovery points
After=network-online.target
# The check reads /mnt/backup. At boot the timer can fire before the NFS
# mount is up (2026-10-03, homelab's return in phase 7): wait for it.
RequiresMountsFor=/mnt/backup

[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=2min
ExecStart=/usr/local/sbin/jocasta-backup --database {{ stack_dir }}/data/jocasta.db --destination /mnt/backup/jocasta --mount /mnt/backup --check-freshness
