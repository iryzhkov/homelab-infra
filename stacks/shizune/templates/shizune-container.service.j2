[Unit]
Description=Start Shizune after private mesh ingress
Requires=docker.service nebula.service shizune-firewall.service
After=docker.service nebula.service shizune-firewall.service
PartOf=docker.service nebula.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ stack_dir }}
ExecStartPre=/usr/sbin/ip address show dev nebula1
ExecStart=/usr/bin/docker compose --project-name shizune up -d --pull never
ExecStop=/usr/bin/docker compose --project-name shizune stop
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
