# INERT. Paths and ports bound by garage-storage-native.py.
metadata_dir = "/mnt/docker-data/swarm/objectstore/meta"
data_dir = "/mnt/nas/ml/garage-blobs"
db_engine = "lmdb"
metadata_fsync = true
data_fsync = true
replication_factor = 1
consistency_mode = "consistent"
compression_level = 1
rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret_file = "/etc/garage/rpc.secret"

[s3_api]
s3_region = "garage"
api_bind_addr = "127.0.0.1:3900"
