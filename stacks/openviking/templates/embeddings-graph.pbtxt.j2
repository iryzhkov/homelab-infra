# Managed by homelab-infra: stacks/openviking/embeddings-prepare.yml
# OVMS embeddings graph for {{ openviking_embeddings.model.repository }}@{{ openviking_embeddings.model.revision }}
input_stream: "REQUEST_PAYLOAD:input"
output_stream: "RESPONSE_PAYLOAD:output"
node {
    name: "EmbeddingsExecutor"
    calculator: "EmbeddingsCalculatorOV"
    input_side_packet: "EMBEDDINGS_NODE_RESOURCES:embeddings_servable"
    input_stream: "REQUEST_PAYLOAD:input"
    output_stream: "RESPONSE_PAYLOAD:output"
    node_options: {
        [type.googleapis.com / mediapipe.EmbeddingsCalculatorOVOptions]: {
            models_path: "/model",
            normalize_embeddings: {{ openviking_embeddings.graph.normalize | bool | lower }},
            truncate: false,
            pooling: {{ openviking_embeddings.graph.pooling }},
            max_length: {{ openviking_embeddings.graph.max_length | int }},
            target_device: "CPU",
            plugin_config: '{{ {"NUM_STREAMS": openviking_embeddings.graph.num_streams | string, "INFERENCE_NUM_THREADS": openviking_embeddings.graph.threads | string} | to_json }}',
        }
    }
}
