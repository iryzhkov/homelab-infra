# One Compose project per CPU runtime; fixed host, no published port.
services:
  {{ ov_provider.key }}:
    image: {{ ov_inference_recipes.runtime_image }}
    container_name: openviking-{{ ov_provider.key }}
    restart: unless-stopped
    cpus: 2
    mem_limit: 2147483648
    memswap_limit: 2147483648
    pids_limit: 256
    environment:
      OLLAMA_HOST: "0.0.0.0:11434"
      OLLAMA_MODELS: /models
      OLLAMA_CONTEXT_LENGTH: "4096"
      OLLAMA_NUM_PARALLEL: "1"
      OLLAMA_MAX_LOADED_MODELS: "1"
      OLLAMA_KEEP_ALIVE: "-1"
      OLLAMA_NOPRUNE: "1"
      OLLAMA_MAX_QUEUE: "1"
    volumes:
      - "{{ ov_runtime_root }}/models:/models"
{% if ov_provider.key == 'generation' %}
      - "{{ ov_runtime_root }}/Modelfile:/recipe/Modelfile:ro"
{% endif %}
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      providers:
        aliases: [{{ ov_provider.key }}]
networks:
  providers:
    external: true
    name: {{ openviking_inference_network }}
