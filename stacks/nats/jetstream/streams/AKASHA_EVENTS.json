{
  "name": "AKASHA_EVENTS",
  "description": "Akasha events, akasha.<source>.<kind>. A replay buffer for the Akasha store, not the store itself: kept 14 days or 1 GiB, whichever is reached first, oldest dropped.",
  "subjects": ["akasha.>"],
  "retention": "limits",
  "storage": "file",
  "num_replicas": 1,
  "discard": "old",
  "max_consumers": 8,
  "max_msgs": -1,
  "max_bytes": 1073741824,
  "max_age": 1209600000000000,
  "max_msg_size": 327680,
  "max_msgs_per_subject": -1,
  "duplicate_window": 600000000000,
  "allow_direct": true,
  "allow_rollup_hdrs": false,
  "deny_delete": true,
  "deny_purge": false,
  "compression": "none",
  "metadata": {}
}
