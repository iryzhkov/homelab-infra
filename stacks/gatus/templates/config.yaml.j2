---
metrics: true
storage:
  type: sqlite
  path: /data/gatus.db

alerting:
  discord:
    webhook-url: "${DISCORD_WEBHOOK_URL}"
    default-alert:
      failure-threshold: 5
      success-threshold: 2
      send-on-resolved: true

default-endpoint: &alerted
  alerts:
    - type: discord

endpoints:
{#
  Internal probes: one per route on the host whose `stacks` list carries it,
  and for a Swarm stack (swarm_stacks_* in inventory/group_vars/swarm/) one
  per worker, since the routing mesh publishes its ports on every worker. A
  Swarm entry wins over the host_vars entry of the same stack name, which
  stays until the phase 5 cleanup.
#}
{% set gatus_swarm_stacks = hostvars | swarm_stacks(groups) %}
{% set gatus_swarm_names = gatus_swarm_stacks | map(attribute='name') | list %}
{% set gatus_probes = [] %}
{% set gatus_routes = [] %}
{% for host_name in groups['docker_hosts'] %}
{% for stack in hostvars[host_name].stacks | default([]) if stack.name not in gatus_swarm_names %}
{% for route in stack.routes | default([]) %}
{% set _ = gatus_probes.append({'host_name': host_name, 'route': route}) %}
{% set _ = gatus_routes.append(route) %}
{% endfor %}
{% endfor %}
{% endfor %}
{% for stack in gatus_swarm_stacks %}
{% set stack_hosts = hostvars | stack_hosts(groups, stack.name) %}
{% for route in stack.routes | default([]) %}
{% for host_name in (stack_hosts if route.port is defined else stack_hosts[:1]) %}
{% set _ = gatus_probes.append({'host_name': host_name, 'route': route}) %}
{% endfor %}
{% set _ = gatus_routes.append(route) %}
{% endfor %}
{% endfor %}
{% for probe in gatus_probes %}
{% set host_name = probe.host_name %}
{% set route = probe.route %}
{% if route.port is defined %}
  - name: {{ route.host }}
{% if inventory_hostname == 'normandy' %}
    <<: *alerted
{% endif %}
    group: Internal on {{ host_name }} via {{ inventory_hostname }}
{% if route.health_check is defined and route.health_check == false %}
    url: "tcp://{{ hostvars[host_name].ansible_host }}:{{ route.port }}"
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
{% else %}
    url: "{{ route.scheme | default('http') }}://{{ hostvars[host_name].ansible_host }}:{{ route.port }}{{ route.health_check.path | default('/') }}"
    interval: 1m
{% if route.scheme | default('http') == 'https' %}
    client:
      insecure: true
{% endif %}
    conditions:
      - "[STATUS] < 500"
      - "[STATUS] != 404"
{% endif %}
{% elif route.url is defined and '127.0.0.1' not in route.url %}
  - name: {{ route.host }}
{% if inventory_hostname == 'normandy' %}
    <<: *alerted
{% endif %}
    group: Internal on {{ host_name }} via {{ inventory_hostname }}
{% if route.monitor_url is defined %}
    url: "{{ route.monitor_url }}"
{% else %}
    url: "{{ route.url }}{{ route.health_check.path | default('/') }}"
{% endif %}
    interval: 1m
    conditions:
      - "[STATUS] >= 200"
      - "[STATUS] < 300"
{% endif %}
{% endfor %}
{% for route in traefik_static_routes %}
  - name: {{ route.host }}
{% if inventory_hostname == 'normandy' %}
    <<: *alerted
{% endif %}
    group: Internal static via {{ inventory_hostname }}
    url: "{{ route.url }}/"
    interval: 1m
    conditions:
      - "[STATUS] >= 200"
      - "[STATUS] < 300"
{% endfor %}
{% for route in gatus_routes %}
{% if route.host in gatus_public_from_lan %}
  - name: {{ route.host }}
{% if inventory_hostname == 'normandy' %}
    <<: *alerted
{% endif %}
    group: Public via {{ inventory_hostname }}
    url: "https://{{ route.host }}/"
    interval: 1m
    client:
      dns-resolver: "tcp://8.8.8.8:53"
    conditions:
      - "[STATUS] >= 200"
      - "[STATUS] < 300"
{% endif %}
{% endfor %}
{% for instance in adguard_instances %}
  - name: AdGuard {{ instance.name }}
{% if inventory_hostname == 'normandy' %}
    <<: *alerted
{% endif %}
    group: Internal infrastructure via {{ inventory_hostname }}
    url: "http://{{ instance.ip }}:{{ adguard_web_port }}/"
    interval: 1m
    conditions:
      - "[STATUS] >= 200"
      - "[STATUS] < 400"
{% endfor %}
  - name: MQTT host ping
{% if inventory_hostname == 'normandy' %}
    <<: *alerted
{% endif %}
    group: Internal static via {{ inventory_hostname }}
    url: "icmp://{{ mqtt_broker_ip }}"
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: Edge proxy TCP
{% if inventory_hostname == 'normandy' %}
    <<: *alerted
{% endif %}
    group: Internal static via {{ inventory_hostname }}
    url: "tcp://{{ edge_proxy_ip }}:443"
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
{% for edge in groups['edge_proxy'] %}
  - name: Edge {{ edge }} TCP
{% if inventory_hostname == 'normandy' %}
    <<: *alerted
{% endif %}
    group: Internal static via {{ inventory_hostname }}
    url: "tcp://{{ hostvars[edge].ansible_host }}:443"
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
{% endfor %}
{% if inventory_hostname == 'normandy' %}
  - name: Gatus homelab
    <<: *alerted
    group: Probe health via {{ inventory_hostname }}
    url: "http://{{ hostvars['homelab'].ansible_host }}:3002/health"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
  - name: Gatus OCI
    <<: *alerted
    group: Probe health via {{ inventory_hostname }}
    url: "http://{{ hostvars['oci'].mesh_host }}:3002/health"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
{% else %}
  - name: Gatus normandy
    <<: *alerted
    group: Probe health via {{ inventory_hostname }}
    url: "http://{{ hostvars['normandy'].ansible_host }}:3002/health"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
{% endif %}
{# A routine converge before token provisioning must keep Gatus usable. #}
{% set publisher_heartbeat_enabled = inventory_hostname == 'homelab' and ((stack_secrets | default({})).CHALDEA_PUBLISHER_HEARTBEAT_TOKEN | default('', true) | trim | length > 0) %}
{% set akasha_tokens = stack_secrets | default({}) %}
{% set akasha_heartbeat_enabled = inventory_hostname == 'homelab' and (akasha_tokens.AKASHA_BACKUP_HEARTBEAT_TOKEN | default('', true) | trim | length > 0 or akasha_tokens.AKASHA_OFFSITE_HEARTBEAT_TOKEN | default('', true) | trim | length > 0 or akasha_tokens.AKASHA_HEALTH_HEARTBEAT_TOKEN | default('', true) | trim | length > 0) %}
{% if publisher_heartbeat_enabled or akasha_heartbeat_enabled or inventory_hostname == smart_gatus_host %}

external-endpoints:
{% if publisher_heartbeat_enabled %}
  # One failed publication or 13h of silence, including a Normandy outage.
  - name: trust-publisher
    group: chaldea
    token: "${CHALDEA_PUBLISHER_HEARTBEAT_TOKEN}"
    heartbeat:
      interval: 13h
    alerts:
      - type: discord
        failure-threshold: 1
        success-threshold: 1
        send-on-resolved: true
{% endif %}
{% if akasha_heartbeat_enabled %}
{% for name, interval in [('backup', '2h'), ('offsite', '26h'), ('health', '3m')] %}
{% set token_key = 'AKASHA_' ~ (name | upper) ~ '_HEARTBEAT_TOKEN' %}
{% if akasha_tokens[token_key] | default('', true) | trim | length > 0 %}
  - name: akasha-{{ name }}
    group: chaldea
    token: "{{ '${' ~ token_key ~ '}' }}"
    heartbeat:
      interval: {{ interval }}
    alerts:
      - type: discord
        failure-threshold: 1
        success-threshold: 1
        send-on-resolved: true
{% endif %}
{% endfor %}
{% endif %}
{% if inventory_hostname == smart_gatus_host %}
# SMART health of the hypervisors' physical drives, pushed every 15 minutes by
# roles/base. The heartbeat turns a collector that stopped into a failure.
{% for host_name in groups['hypervisors'] %}
{% for drive in hostvars[host_name].smart_drives | default([]) %}
  - name: "{{ host_name }} {{ drive.model }} {{ drive.serial }}"
    <<: *alerted
    group: {{ smart_gatus_group }}
    token: "{{ smart_secrets.GATUS_TOKEN }}"
    heartbeat:
      interval: {{ smart_heartbeat }}
{% endfor %}
{% endfor %}
{% endif %}
{% endif %}
